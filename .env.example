# Copy this file to `.env` and fill in values as needed. NEVER commit `.env`.
# Phases 1–3 need none of these — sensible defaults are baked into astro.config.mjs.

# --- Deployment (GitHub Pages) ---
# Full origin, no trailing path. Example for a project site:
#   https://YOUR-USERNAME.github.io
# For a custom domain later: https://hub.example.com
SITE_URL=

# Path the site is served under. For a project site this is "/REPO-NAME".
# For a custom domain (served at the root) set this to "/".
BASE_PATH=

# --- Supabase (Phase 4 — student portal) ---
# The ONLY allowed project. The safety guard rejects any other URL.
# Only the Project URL and the anon PUBLIC key ever belong here.
# NEVER put the service_role key or the database password anywhere.
# Leaving the anon key as the placeholder keeps the portal OFF (site still works).
PUBLIC_SUPABASE_URL=https://rrjyfrqidwndgfgdncnp.supabase.co
PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

# --- Certificate email (Vercel only: api/send-certificate.js, Gmail SMTP) ---
# Set these in Vercel → Project → Settings → Environment Variables (NOT committed).
# GMAIL_APP_PASSWORD is a Google "App Password" (16 chars), created after turning on
# 2-Step Verification. NEVER your normal Gmail password, and never commit it.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Paystack (course payments) ---
# PUBLIC_PAYSTACK_KEY is the PUBLIC key (safe in the browser). The SECRET key and
# webhook verification live ONLY in Vercel env, never in the repo.
PUBLIC_PAYSTACK_KEY=
PAYSTACK_SECRET_KEY=
# A long random string (e.g. `openssl rand -hex 32`). Set the SAME value here in
# Vercel AND in Supabase: insert into app_config('grant_signing_secret', ...).
GRANT_SIGNING_SECRET=

# --- Lulu AI chat assistant (Vercel only: api/lulu-chat.js) ---
# The Google Gemini API key that powers Lulu. Set it ONLY in Vercel env (never commit it).
# Get one free (no card) at https://aistudio.google.com/apikey. Without it, Lulu
# politely says it is not configured and points visitors to Contact.
GEMINI_API_KEY=
# Optional: override the model. Default is gemini-2.5-flash (free tier, fast + low cost).
GEMINI_MODEL=
# Set PUBLIC_LULU_ENABLED=false to hide the Lulu widget entirely.
PUBLIC_LULU_ENABLED=

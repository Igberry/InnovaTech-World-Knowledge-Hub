# Copy this file to `.env` and fill in values as needed. NEVER commit `.env`.
# Phases 1–3 need none of these — sensible defaults are baked into astro.config.mjs.

# --- Deployment (GitHub Pages) ---
# Full origin, no trailing path. Example for a project site:
#   https://YOUR-USERNAME.github.io
# For a custom domain later: https://hub.example.com
SITE_URL=

# Path the site is served under. For a project site this is "/REPO-NAME".
# For a custom domain (served at the root) set this to "/".
BASE_PATH=

# --- Supabase (Phase 4 — student portal) ---
# The ONLY allowed project. The safety guard rejects any other URL.
# Only the Project URL and the anon PUBLIC key ever belong here.
# NEVER put the service_role key or the database password anywhere.
# Leaving the anon key as the placeholder keeps the portal OFF (site still works).
PUBLIC_SUPABASE_URL=https://rrjyfrqidwndgfgdncnp.supabase.co
PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

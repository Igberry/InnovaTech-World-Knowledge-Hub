---
/**
 * Header auth area (STUDENT-PORTAL-SPEC.md §6.2). Renders nothing until the
 * client script decides the state, so there's no flash of the wrong link. Hidden
 * entirely when the portal isn't configured.
 */
---

<span class="auth-nav" data-auth-nav hidden></span>

<!-- Styles are global (not scoped) because the links below are injected via
     innerHTML at runtime, so Astro's scoped selectors would not match them. -->
<style is:global>
  .auth-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    flex-wrap: nowrap;
  }
  .auth-nav a,
  .auth-nav button {
    font: inherit;
    font-weight: 600;
    font-size: 0.88rem;
    line-height: 1;
    color: var(--color-blue-700);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.4rem 0.45rem;
    border: none;
    border-radius: 0.5rem;
    background: none;
    cursor: pointer;
  }
  .auth-nav a:hover,
  .auth-nav button:hover {
    background: var(--color-burgundy-50);
    color: var(--color-burgundy-text);
  }
  .auth-nav button {
    color: var(--color-muted);
  }
  /* The signed-in identity: muted, with a subtle divider before it. */
  .auth-nav .auth-name {
    color: var(--color-muted);
    font-weight: 500;
    font-size: 0.9rem;
    white-space: nowrap;
    max-width: 11rem;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 0.4rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-border);
  }
  /* Hide the name until the row has comfortable room, so it never forces overflow. */
  @media (max-width: 1360px) {
    .auth-nav .auth-name {
      display: none;
    }
  }
</style>

<script>
  import { isPortalEnabled } from '../lib/portal-config';
  import { withBase } from '../utils/links';

  const el = document.querySelector<HTMLElement>('[data-auth-nav]');
  if (el && isPortalEnabled) {
    // Load the Supabase client only when the portal is on (keeps it off public builds).
    const { onAuthChange, isAdmin, getProfile, signOut } = await import('../lib/auth');
    el.hidden = false;
    const paint = (loggedIn: boolean, admin: boolean, name: string) => {
      if (!loggedIn) {
        el.innerHTML = `<a href="${withBase('/login/')}">Log in</a>`;
        return;
      }
      el.innerHTML =
        `<a href="${withBase('/account/')}">My Learning</a>` +
        (admin ? `<a href="${withBase('/admin/')}">Admin</a>` : '') +
        `<span class="auth-name" title="${name}">${name}</span>` +
        `<button type="button" data-logout>Log out</button>`;
      el.querySelector('[data-logout]')?.addEventListener('click', async () => {
        await signOut();
        window.location.href = withBase('/');
      });
    };

    const render = async (loggedIn: boolean) => {
      if (!loggedIn) {
        paint(false, false, '');
        return;
      }
      const [admin, profile] = await Promise.all([isAdmin(), getProfile()]);
      const name = profile?.full_name?.trim() || 'My account';
      paint(true, admin, name);
      // Right after sign-in the admin RPC can resolve `false` before the session
      // token is attached, which would hide the Admin link. Re-check once shortly
      // after; if the user really is an admin, repaint with the link showing.
      if (!admin) {
        setTimeout(async () => {
          if (await isAdmin()) paint(true, true, name);
        }, 600);
      }
    };

    // Supabase runs onAuthStateChange callbacks inside an auth lock; awaiting
    // other Supabase calls directly here can see a not-yet-attached session.
    // Defer with setTimeout(0) so isAdmin()/getProfile() run with a live token.
    onAuthChange((user) => setTimeout(() => render(!!user), 0));
  }
</script>

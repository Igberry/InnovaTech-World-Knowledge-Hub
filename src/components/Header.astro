---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import AuthNav from './AuthNav.astro';
import { site } from '../config/site';
import { withBase } from '../utils/links';

const current = Astro.url.pathname;
function isActive(href: string): boolean {
  const target = withBase(href);
  if (href === '/') return current === target || current === withBase('/');
  return current.startsWith(target);
}

function isNavItemActive(item: (typeof site.nav)[number]): boolean {
  return isActive(item.href) || ('children' in item && item.children.some((child) => isActive(child.href)));
}
---

<header class="site-header" data-pagefind-ignore>
  <div class="container header-inner">
    <a href={withBase('/')} class="header-logo" aria-label={`${site.name} - home`}>
      <Logo height={38} />
    </a>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              {'children' in item ? (
                <details class="nav-dropdown">
                  <summary
                    class:list={{ 'is-active': isNavItemActive(item) }}
                    aria-controls="about-subnav"
                    aria-expanded="false"
                  >
                    {item.label}
                    <Icon name="lucide:chevron-down" width={15} height={15} aria-hidden="true" />
                  </summary>
                  <ul id="about-subnav" class="nav-dropdown-menu">
                    {item.children.map((child) => (
                      <li>
                        <a href={withBase(child.href)} aria-current={isActive(child.href) ? 'page' : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <form class="nav-search" role="search" action={withBase('/search/')} method="get">
        <Icon name="lucide:search" width={16} height={16} aria-hidden="true" />
        <input type="search" name="q" placeholder="Search" aria-label="Search lessons and courses" />
      </form>
      <a href={withBase('/courses/')} class="btn btn-primary nav-cta">Start Learning</a>
    </nav>

    <div class="header-right">
      <AuthNav />
      <ThemeToggle />
      <button
        class="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <Icon name="lucide:menu" width={24} height={24} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Always a white header so the navy logo stays visible in every theme. */
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    color: #0f172a;
    /* Pin light colours inside the header so its text/controls stay readable on white. */
    --color-ink: #0f172a;
    --color-muted: #475569;
    --surface: #ffffff;
    --color-border: #e2e8f0;
    --color-blue-50: #eaf1f7;
    --color-blue-100: #d2e0ee;
    --color-blue-200: #a7c3dd;
    --color-blue-600: #0b3b66;
    --color-blue-700: #0a3057;
    --color-burgundy-50: #f9edf0;
    --color-burgundy-700: #69001a;
    --color-burgundy-900: #3d0010;
    --color-burgundy-text: #69001a;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-height: 4rem;
  }
  .header-logo {
    display: inline-flex;
    flex: 0 0 auto; /* never let the logo shrink/collapse when the row is tight */
  }
  .header-right {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: nowrap;
  }
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--surface);
    color: var(--color-ink);
    cursor: pointer;
  }
  .primary-nav {
    display: none;
  }
  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .primary-nav a {
    display: inline-block;
    padding: 0.4rem 0.55rem;
    border-radius: 0.5rem;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .primary-nav a:hover {
    background: var(--color-burgundy-50);
    color: var(--color-burgundy-text);
  }
  .primary-nav a[aria-current='page'] {
    color: var(--color-burgundy-text);
    background: var(--color-burgundy-50);
  }
  .nav-dropdown {
    position: relative;
  }
  .nav-dropdown summary {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0.55rem;
    border-radius: 0.5rem;
    color: var(--color-ink);
    cursor: pointer;
    font-weight: 500;
    font-size: 0.95rem;
    list-style: none;
    white-space: nowrap;
  }
  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }
  .nav-dropdown summary:hover,
  .nav-dropdown summary.is-active {
    background: var(--color-burgundy-50);
    color: var(--color-burgundy-text);
  }
  .nav-dropdown[open] summary svg {
    transform: rotate(180deg);
  }
  .nav-dropdown-menu {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    position: absolute;
    z-index: 60;
    top: calc(100% + 0.45rem);
    left: 0;
    min-width: 11rem;
    padding: 0.4rem !important;
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    background: #fff;
    box-shadow: 0 10px 24px rgba(4, 23, 43, 0.12);
  }
  .nav-dropdown-menu a {
    display: block;
    width: 100%;
  }
  .nav-cta {
    margin-left: 0.5rem;
    white-space: nowrap;
  }
  /* The "Start Learning" button is a primary button, not a nav text link:
     keep its text white on the navy fill (override .primary-nav a colour). */
  .primary-nav a.nav-cta,
  .primary-nav a.nav-cta:hover {
    color: #fff;
  }
  .primary-nav a.nav-cta:hover {
    background: var(--color-burgundy-700);
  }
  .nav-search {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--surface, #fff);
    color: var(--color-muted);
  }
  .nav-search input {
    border: none;
    background: transparent;
    outline: none;
    font: inherit;
    color: var(--color-ink);
    width: 6.5rem;
    min-width: 0;
  }
  .nav-search:focus-within {
    border-color: var(--color-blue-400);
  }

  /* Mobile + tablet menu (open state toggled by script) */
  @media (max-width: 1239px) {
    .primary-nav.open {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      position: absolute;
      left: 0;
      right: 0;
      top: 4rem;
      background: var(--surface);
      border-bottom: 1px solid var(--color-border);
      padding: 1rem;
      box-shadow: 0 10px 24px rgba(18, 42, 107, 0.08);
    }
    .primary-nav.open ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    .nav-dropdown-menu {
      display: flex;
      flex-direction: column;
      position: static;
      min-width: 0;
      margin: 0.25rem 0 0 0.75rem !important;
      border: 0;
      border-left: 2px solid var(--color-blue-200);
      border-radius: 0;
      box-shadow: none;
    }
    .nav-dropdown summary {
      justify-content: space-between;
      width: 100%;
    }
    .primary-nav.open .nav-cta {
      margin-left: 0;
      text-align: center;
    }
    .primary-nav.open .nav-search {
      order: -1;
    }
    .primary-nav.open .nav-search input {
      flex: 1;
      width: auto;
    }
  }

  /* Desktop */
  @media (min-width: 1240px) {
    .nav-toggle {
      display: none;
    }
    .primary-nav {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      /* Start the nav right after the logo; push the auth cluster to the far right. */
      margin-right: auto;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (toggle && nav) {
    const dropdowns = nav.querySelectorAll<HTMLDetailsElement>('.nav-dropdown');
    dropdowns.forEach((dropdown) => {
      const summary = dropdown.querySelector('summary');
      dropdown.addEventListener('toggle', () => {
        summary?.setAttribute('aria-expanded', String(dropdown.open));
      });
    });
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') {
        nav.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const openDropdown = nav.querySelector<HTMLDetailsElement>('.nav-dropdown[open]');
        if (openDropdown) {
          openDropdown.open = false;
          openDropdown.querySelector('summary')?.focus();
        } else if (nav.classList.contains('open')) {
          nav.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
      }
    });
  }
</script>

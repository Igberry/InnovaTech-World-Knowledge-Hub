---
import { Icon } from 'astro-icon/components';
import { withBase, whatsappUrl } from '../utils/links';

const enabled = import.meta.env.PUBLIC_LULU_ENABLED !== 'false';
const whatsapp = whatsappUrl('training');
---

{enabled && (
  <aside
    class="lulu"
    data-lulu
    data-endpoint="/api/lulu-chat"
    data-contact={withBase('/contact/')}
    data-courses={withBase('/courses/')}
    data-whatsapp={whatsapp ?? withBase('/contact/')}
  >
    <section class="lulu-panel" id="lulu-panel" role="dialog" aria-modal="false" aria-labelledby="lulu-title" hidden>
      <header class="lulu-header">
        <h2 id="lulu-title">Chat with Lulu</h2>
        <div class="lulu-controls">
          <button class="lulu-control" type="button" aria-label="Minimize Lulu chat" data-lulu-minimize>
            <Icon name="lucide:minus" width={20} height={20} aria-hidden="true" />
          </button>
          <button class="lulu-control" type="button" aria-label="Close Lulu chat" data-lulu-close>
          <Icon name="lucide:x" width={20} height={20} aria-hidden="true" />
          </button>
        </div>
      </header>
      <ol class="lulu-messages" data-lulu-messages role="log" aria-live="polite" aria-relevant="additions text">
        <li class="lulu-message lulu-assistant">
          <span class="lulu-speaker">Lulu</span>
          <p class="lulu-bubble">Hi, I’m Lulu, InnovaTech’s AI assistant. Ask me about our courses, plans and prices, services, or how the site works. Please don’t share passwords, payment details, student records or other sensitive information.</p>
        </li>
      </ol>
      <details class="lulu-info">
        <summary>Privacy and contact</summary>
        <p class="lulu-privacy">
          Your message is sent to InnovaTech’s AI assistant (powered by Google’s Gemini) to generate a reply. InnovaTech does not save chat transcripts.
          <a href={withBase('/privacy/')}>Privacy details</a>
          <span>Need a person? <a href={whatsapp ?? withBase('/contact/')} target={whatsapp ? '_blank' : undefined} rel={whatsapp ? 'noopener noreferrer' : undefined}>Contact InnovaTech</a></span>
        </p>
      </details>
      <form class="lulu-form" data-lulu-form>
        <label class="sr-only" for="lulu-input">Your question</label>
        <input id="lulu-input" name="message" type="text" maxlength="1500" autocomplete="off" placeholder="Enter your message..." required />
        <button class="btn btn-primary lulu-send" type="submit" aria-label="Send message" data-lulu-send>
          <Icon name="lucide:send" width={17} height={17} aria-hidden="true" />
        </button>
      </form>
      <p class="lulu-status" data-lulu-status role="status" aria-live="polite"></p>
    </section>
    <button class="lulu-launch" type="button" aria-expanded="false" aria-controls="lulu-panel" data-lulu-open>
      <Icon name="lucide:message-circle" width={21} height={21} aria-hidden="true" />
      <span>Chat with Lulu</span>
    </button>
  </aside>
)}

{enabled && (
  <script>
    type ChatTurn = { role: 'user' | 'assistant'; content: string };

    const root = document.querySelector<HTMLElement>('[data-lulu]');
    const panel = document.getElementById('lulu-panel');
    const openButton = root?.querySelector<HTMLButtonElement>('[data-lulu-open]');
    const closeButton = root?.querySelector<HTMLButtonElement>('[data-lulu-close]');
    const minimizeButton = root?.querySelector<HTMLButtonElement>('[data-lulu-minimize]');
    const form = root?.querySelector<HTMLFormElement>('[data-lulu-form]');
    const input = root?.querySelector<HTMLInputElement>('#lulu-input');
    const messages = root?.querySelector<HTMLOListElement>('[data-lulu-messages]');
    const status = root?.querySelector<HTMLElement>('[data-lulu-status]');
    const sendButton = root?.querySelector<HTMLButtonElement>('[data-lulu-send]');
    const history: ChatTurn[] = [];
    let sending = false;

    function setOpen(open: boolean) {
      if (!panel || !openButton) return;
      panel.hidden = !open;
      openButton.setAttribute('aria-expanded', String(open));
      if (open) input?.focus();
      else openButton.focus();
    }

    function addMessage(role: 'user' | 'assistant', text: string) {
      if (!messages) return;
      const item = document.createElement('li');
      item.className = `lulu-message lulu-${role}`;
      const speaker = document.createElement('span');
      speaker.className = 'lulu-speaker';
      speaker.textContent = role === 'user' ? 'me' : 'Lulu';
      const paragraph = document.createElement('p');
      paragraph.className = 'lulu-bubble';
      const linkPattern = /(https?:\/\/[^\s<>"']+|\/[a-zA-Z0-9._~!$&'()*+,;=:@%/-]+)/g;
      let offset = 0;
      for (const match of text.matchAll(linkPattern)) {
        const index = match.index ?? 0;
        if (index > offset) paragraph.append(document.createTextNode(text.slice(offset, index)));
        const rawLink = match[0].replace(/[.,!?;:]+$/, '');
        const trailing = match[0].slice(rawLink.length);
        try {
          const url = new URL(rawLink, window.location.origin);
          if (url.protocol === 'https:' || url.protocol === 'http:') {
            const link = document.createElement('a');
            link.href = url.href;
            link.textContent = rawLink;
            if (url.origin !== window.location.origin) {
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
            }
            paragraph.append(link);
          } else {
            paragraph.append(document.createTextNode(rawLink));
          }
        } catch {
          paragraph.append(document.createTextNode(rawLink));
        }
        if (trailing) paragraph.append(document.createTextNode(trailing));
        offset = index + match[0].length;
      }
      if (offset < text.length) paragraph.append(document.createTextNode(text.slice(offset)));
      item.append(speaker);
      item.append(paragraph);
      messages.append(item);
      messages.scrollTop = messages.scrollHeight;
    }

    openButton?.addEventListener('click', () => setOpen(panel?.hidden ?? true));
    closeButton?.addEventListener('click', () => setOpen(false));
    minimizeButton?.addEventListener('click', () => setOpen(false));
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const message = input?.value.trim();
      if (!message || sending || !root) return;
      addMessage('user', message);
      history.push({ role: 'user', content: message });
      if (input) input.value = '';
      sending = true;
      if (sendButton) sendButton.disabled = true;
      if (input) input.disabled = true;
      if (status) status.textContent = 'Lulu is typing…';

      const endpoint = root.dataset.endpoint ?? '/api/lulu-chat';
      const fallback = root.dataset.whatsapp ?? '/contact/';
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          // Send a trimmed, recent window of the conversation.
          body: JSON.stringify({ messages: history.slice(-12) }),
        });
        const data: unknown = await response.json().catch(() => ({}));
        const payload = (data && typeof data === 'object' ? data : {}) as {
          reply?: string;
          error?: string;
        };
        if (response.ok && payload.reply) {
          addMessage('assistant', payload.reply);
          history.push({ role: 'assistant', content: payload.reply });
          if (status) status.textContent = '';
        } else {
          const notice = payload.error || 'Lulu could not reply right now.';
          addMessage('assistant', `${notice} You can reach a person here: ${fallback}`);
          // Don't keep an unanswered user turn that would confuse the next request.
          if (history[history.length - 1]?.role === 'user') history.pop();
          if (status) status.textContent = 'The reply could not be completed.';
        }
      } catch {
        addMessage('assistant', `Lulu could not reach the server. You can contact InnovaTech here: ${fallback}`);
        if (history[history.length - 1]?.role === 'user') history.pop();
        if (status) status.textContent = 'The reply could not be completed.';
      } finally {
        sending = false;
        if (sendButton) sendButton.disabled = false;
        if (input) {
          input.disabled = false;
          input.focus();
        }
      }
    });
  </script>
)}

<style>
  .lulu {
    position: fixed;
    z-index: 60;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    font-family: var(--font-sans);
  }
  .lulu-launch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-burgundy-600);
    border-radius: 999px;
    background: var(--color-burgundy-600);
    color: #fff;
    font: inherit;
    font-weight: 600;
    box-shadow: 0 4px 16px rgb(15 23 42 / 20%);
    cursor: pointer;
  }
  .lulu-launch:hover { background: var(--color-burgundy-700); }
  .lulu-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.75rem);
    display: flex;
    flex-direction: column;
    width: min(22rem, calc(100vw - 1.5rem));
    max-height: min(36rem, calc(100dvh - 5.5rem));
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--surface);
    color: var(--color-ink);
    box-shadow: 0 12px 40px rgb(15 23 42 / 22%);
  }
  .lulu-panel[hidden] { display: none; }
  .lulu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.5rem 0.6rem 0.9rem;
    background: var(--color-burgundy-600);
    color: #fff;
  }
  .lulu-header h2 { margin: 0; font-size: 0.95rem; color: #fff; }
  .lulu-controls { display: flex; align-items: center; gap: 0.25rem; }
  .lulu-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    min-height: 2.1rem;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .lulu-control:hover { background: rgb(255 255 255 / 18%); }
  .lulu-messages {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 0.85rem;
    min-height: 10rem;
    overflow-y: auto;
    margin: 0;
    padding: 0.9rem 0.75rem;
    list-style: none;
  }
  .lulu-messages :global(.lulu-message) { display: flex; flex-direction: column; gap: 0.3rem; max-width: 92%; }
  .lulu-messages :global(.lulu-speaker) { color: var(--color-muted); font-size: 0.75rem; }
  .lulu-messages :global(.lulu-bubble) { margin: 0; padding: 0.65rem 0.8rem; border-radius: 1rem; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.9rem; }
  .lulu-messages :global(.lulu-message a) { overflow-wrap: anywhere; }
  .lulu-messages :global(.lulu-assistant) { align-self: flex-start; align-items: flex-start; }
  .lulu-messages :global(.lulu-assistant .lulu-bubble) { background: var(--color-blue-50); }
  .lulu-messages :global(.lulu-user) { align-self: flex-end; align-items: flex-end; }
  .lulu-messages :global(.lulu-user .lulu-bubble) { background: var(--color-burgundy-50); }
  .lulu-info { padding: 0.4rem 0.75rem; border-top: 1px solid var(--color-border); color: var(--color-muted); font-size: 0.72rem; }
  .lulu-info summary { width: fit-content; cursor: pointer; }
  .lulu-privacy { display: grid; gap: 0.25rem; margin: 0.4rem 0 0; }
  .lulu-privacy a { color: var(--color-burgundy-text); }
  .lulu-form { display: flex; gap: 0.5rem; padding: 0.5rem 0.65rem; border-top: 1px solid var(--color-border); }
  .lulu-form input {
    min-width: 0;
    flex: 1 1 auto;
    padding: 0.6rem 0.65rem;
    border: 0;
    border-radius: 0.25rem;
    background: var(--bg);
    color: var(--color-ink);
    font: inherit;
  }
  .lulu-form .btn { flex: 0 0 auto; min-width: 2.5rem; min-height: 2.5rem; padding: 0.55rem; }
  .lulu-form .btn:disabled { cursor: wait; opacity: 0.65; }
  .lulu-status { min-height: 0; margin: 0; padding: 0 0.75rem 0.3rem; color: var(--color-muted); font-size: 0.75rem; }
  .lulu :focus-visible { outline: 3px solid var(--color-burgundy-600); outline-offset: 2px; }
  @media (max-width: 420px) {
    .lulu { right: max(0.75rem, env(safe-area-inset-right)); bottom: max(0.75rem, env(safe-area-inset-bottom)); }
    .lulu-panel { width: calc(100vw - 1.5rem); max-height: calc(100dvh - 5.5rem); }
  }
</style>

---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import Newsletter from './Newsletter.astro';
import { site, isTodo } from '../config/site';
import { withBase, formEndpoint, phoneUrl } from '../utils/links';

const socialPlatforms = [
  { platform: 'Facebook', url: site.social.facebook, icon: 'lucide:facebook' },
  { platform: 'Instagram', url: site.social.instagram, icon: 'lucide:instagram' },
  { platform: 'LinkedIn', url: site.social.linkedin, icon: 'lucide:linkedin' },
];
const hasNewsletter = formEndpoint('newsletter') !== null;
const phone = phoneUrl();
const email = isTodo(site.contact.email) ? null : site.contact.email;
const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  {
    hasNewsletter && (
      <div class="container footer-newsletter">
        <Newsletter />
      </div>
    )
  }
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo height={40} badge />
      <p>{site.description}</p>
      <p class="footer-loc">
        <Icon name="lucide:map-pin" width={16} height={16} aria-hidden="true" />
        {site.location}
      </p>
      {
        phone && (
          <p class="footer-loc">
            <Icon name="lucide:phone" width={16} height={16} aria-hidden="true" />
            <a href={phone}>{site.contact.phone}</a>
          </p>
        )
      }
      {
        email && (
          <p class="footer-loc">
            <Icon name="lucide:mail" width={16} height={16} aria-hidden="true" />
            <a href={`mailto:${email}`}>{email}</a>
          </p>
        )
      }
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={withBase(item.href)}>{item.label}</a>
            {'children' in item && (
              <ul class="footer-subnav">
                {item.children.filter((child) => child.href !== item.href).map((child) => (
                  <li><a href={withBase(child.href)}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
        <li><a href={withBase('/showcase/')}>Student Showcase</a></li>
        <li><a href={withBase('/verify/')}>Verify a Certificate</a></li>
        <li><a href={withBase('/privacy/')}>Privacy Policy</a></li>
        <li><a href={withBase('/terms/')}>Terms of Use</a></li>
      </ul>
    </nav>

    <div class="footer-social">
      <h2>Follow</h2>
      <ul class="social-icons">
        {socialPlatforms.map((s) => (
          <li>
            {isTodo(s.url) ? (
              <span class="social-icon-pending" title={`${s.platform} link will be added soon`}>
                <Icon name={s.icon} width={21} height={21} aria-hidden="true" />
                <span class="sr-only">{s.platform} link will be added soon</span>
              </span>
            ) : (
              <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`InnovaTech World on ${s.platform}`}>
                <Icon name={s.icon} width={21} height={21} aria-hidden="true" />
                <span class="sr-only">{s.platform}</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} InnovaTech World. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-blue-900);
    color: #cbd5e1;
    margin-top: 4rem;
    padding-top: 2.5rem;
  }
  .footer-newsletter {
    padding-bottom: 2rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
  }
  .footer-brand p {
    margin-top: 0.75rem;
    font-size: 0.925rem;
    max-width: 40ch;
  }
  .footer-loc {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .site-footer h2 {
    color: #fff;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .site-footer .footer-subnav {
    margin: 0.4rem 0 0 0.8rem;
    gap: 0.35rem;
  }
  .site-footer a {
    color: #cbd5e1;
    text-decoration: none;
  }
  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: capitalize;
  }
  .social-icons {
    flex-direction: row !important;
    gap: 0.75rem !important;
  }
  .social-icons a,
  .social-icon-pending {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
  }
  .social-icon-pending {
    color: #cbd5e1;
    opacity: 0.8;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 1.25rem;
    font-size: 0.85rem;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>

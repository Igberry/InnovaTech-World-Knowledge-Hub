---
import { Icon } from 'astro-icon/components';
import { whatsappUrl } from '../utils/links';

export interface Props {
  course?: string;
  label?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { course, label = 'Chat on WhatsApp', variant = 'primary', class: className = '' } = Astro.props;
const url = whatsappUrl(course);
---

{
  url ? (
    <a class={`btn btn-${variant} btn-whatsapp-${variant} ${className}`} href={url} target="_blank" rel="noopener noreferrer">
      <Icon name="lucide:message-circle" width={18} height={18} aria-hidden="true" />
      {label}
    </a>
  ) : (
    /* No WhatsApp number configured yet - hidden in the UI, flagged in dev. */
    <Fragment>
      {import.meta.env.DEV && (
        <span class="wa-missing" role="note">
          [dev] WhatsApp hidden: set contact.whatsappNumber in src/config/site.ts
        </span>
      )}
    </Fragment>
  )
}

<style>
  .btn-whatsapp-primary {
    background: #15803d;
    color: #fff;
    border-color: #15803d;
  }
  .btn-whatsapp-primary:hover {
    background: #166534;
    color: #fff;
    border-color: #166534;
  }
  .btn-whatsapp-secondary {
    color: #15803d;
  }
  .btn-whatsapp-secondary:hover {
    color: #166534;
    background: color-mix(in srgb, #22c55e 10%, transparent);
    border-color: #22c55e;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .btn-whatsapp-secondary {
      color: #4ade80;
    }
    :root:not([data-theme='light']) .btn-whatsapp-secondary:hover {
      color: #86efac;
    }
  }
  :root[data-theme='dark'] .btn-whatsapp-secondary {
    color: #4ade80;
  }
  :root[data-theme='dark'] .btn-whatsapp-secondary:hover {
    color: #86efac;
  }
  .wa-missing {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--color-warning);
    border: 1px dashed var(--color-warning);
    padding: 0.3rem 0.6rem;
    border-radius: 0.4rem;
  }
</style>

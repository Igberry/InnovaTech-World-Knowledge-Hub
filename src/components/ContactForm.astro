---
/**
 * Contact form (WEBSITE-BUILD-PROMPT.md §7.8, §10). Posts directly to the
 * configured form service (e.g. Formspree) — no backend, works on a static host.
 * If no endpoint is configured, renders nothing (the page shows a WhatsApp/email
 * fallback instead). Includes a honeypot field for basic spam protection.
 */
import { formEndpoint } from '../utils/links';
import { site } from '../config/site';

const endpoint = formEndpoint('contact');
---

{
  endpoint && (
    <form class="form" action={endpoint} method="POST">
      <input type="hidden" name="_subject" value={`New message from ${site.name}`} />
      <div class="field">
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="cf-email">Email</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" rows="5" required />
      </div>
      {/* Honeypot: real users leave this empty; bots fill it. */}
      <div class="hp" aria-hidden="true">
        <label for="cf-company">Company</label>
        <input id="cf-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <button type="submit" class="btn btn-primary">Send message</button>
    </form>
  )
}

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .field label {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .field input,
  .field textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--color-ink);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--color-blue-400);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form button {
    align-self: flex-start;
  }
</style>

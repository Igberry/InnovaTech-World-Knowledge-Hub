---
import { Icon } from 'astro-icon/components';

export interface Props {
  course: string;
  lesson: string;
}
const { course, lesson } = Astro.props;
---

<button class="mark-complete" data-course={course} data-lesson={lesson} aria-pressed="false">
  <Icon name="lucide:circle" width={18} height={18} aria-hidden="true" class="mc-icon-todo" />
  <Icon name="lucide:check-circle-2" width={18} height={18} aria-hidden="true" class="mc-icon-done" />
  <span class="mc-text">Mark as complete</span>
</button>

<style>
  .mark-complete {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    padding: 0.6rem 1rem;
    border-radius: 0.6rem;
    border: 1.5px solid var(--color-blue-200);
    background: var(--surface);
    color: var(--color-blue-700);
    cursor: pointer;
  }
  .mark-complete:hover {
    background: var(--color-blue-50);
  }
  .mark-complete[aria-pressed='true'] {
    background: #f0fdf4;
    border-color: var(--color-success);
    color: #166534;
  }
  .mc-icon-done {
    display: none;
  }
  .mark-complete[aria-pressed='true'] .mc-icon-done {
    display: inline;
  }
  .mark-complete[aria-pressed='true'] .mc-icon-todo {
    display: none;
  }
</style>

<script>
  import { isComplete, toggleComplete } from '../scripts/progress';
  document.querySelectorAll<HTMLButtonElement>('.mark-complete').forEach((btn) => {
    const course = btn.dataset.course!;
    const lesson = btn.dataset.lesson!;
    const sync = (done: boolean) => {
      btn.setAttribute('aria-pressed', String(done));
      btn.querySelector('.mc-text')!.textContent = done ? 'Completed' : 'Mark as complete';
    };
    sync(isComplete(course, lesson));
    btn.addEventListener('click', () => sync(toggleComplete(course, lesson)));
  });
</script>

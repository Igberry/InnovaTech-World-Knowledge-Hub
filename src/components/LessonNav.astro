---
import { Icon } from 'astro-icon/components';
import type { Lesson } from '../utils/courses';
import { lessonSlug } from '../utils/courses';
import { withBase } from '../utils/links';

export interface Props {
  prev: Lesson | null;
  next: Lesson | null;
  courseSlug: string;
}
const { prev, next, courseSlug } = Astro.props;
const url = (l: Lesson) => withBase(`/courses/${courseSlug}/${lessonSlug(l)}/`);
---

<nav class="lesson-nav" aria-label="Lesson navigation">
  {
    prev ? (
      <a class="lesson-nav-link prev" href={url(prev)} rel="prev">
        <Icon name="lucide:arrow-left" width={18} height={18} aria-hidden="true" />
        <span>
          <small>Previous</small>
          {prev.data.title}
        </span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a class="lesson-nav-link next" href={url(next)} rel="next">
        <span>
          <small>Next</small>
          {next.data.title}
        </span>
        <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
      </a>
    ) : (
      <span />
    )
  }
</nav>

<style>
  .lesson-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .lesson-nav-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--surface);
  }
  .lesson-nav-link:hover {
    border-color: var(--color-blue-200);
    background: var(--color-blue-50);
  }
  .lesson-nav-link.next {
    justify-content: flex-end;
    text-align: right;
  }
  .lesson-nav-link small {
    display: block;
    font-size: 0.75rem;
    color: var(--color-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .lesson-nav-link span {
    font-weight: 600;
    line-height: 1.3;
  }
  @media (max-width: 520px) {
    .lesson-nav {
      grid-template-columns: 1fr;
    }
  }
</style>

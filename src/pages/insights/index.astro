---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getInsights, insightSlug, formatDate } from '../../utils/insights';
import { withBase } from '../../utils/links';

const posts = await getInsights();
---

<BaseLayout
  title="Insights"
  description="Practical articles on tech careers, remote work, and learning digital skills."
>
  <header class="page-head">
    <h1>Insights</h1>
    <p>Practical, honest articles on building digital skills, tech careers, and remote work.</p>
  </header>

  {
    posts.length === 0 ? (
      <p class="empty">No articles yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="card card-link post-card" href={withBase(`/insights/${insightSlug(post)}/`)}>
              <div class="post-meta">
                <time datetime={post.data.publishDate.toISOString()}>
                  {formatDate(post.data.publishDate)}
                </time>
                {post.data.author && <span>· {post.data.author}</span>}
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
              )}
              <span class="post-more">
                Read article
                <Icon name="lucide:arrow-right" width={16} height={16} aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <p class="rss-link">
    <a href={withBase('/rss.xml')}>
      <Icon name="lucide:rss" width={15} height={15} aria-hidden="true" /> RSS feed
    </a>
  </p>
</BaseLayout>

<style>
  .page-head {
    margin: 0.5rem 0 1.5rem;
  }
  .page-head h1 {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
  }
  .page-head p {
    color: var(--color-muted);
    font-size: 1.1rem;
    margin-top: 0.5rem;
    max-width: 55ch;
  }
  .empty {
    color: var(--color-muted);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem;
    color: inherit;
    text-decoration: none;
  }
  .post-meta {
    display: flex;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .post-card h2 {
    font-size: 1.35rem;
  }
  .post-card p {
    color: var(--color-muted);
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .post-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--color-blue-700);
  }
  .rss-link {
    margin-top: 2rem;
  }
  .rss-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted);
    text-decoration: none;
  }
  @media (min-width: 760px) {
    .post-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import { getPublicInsight, renderInsightMarkdown } from '../../lib/insights';
import { formatDate } from '../../utils/insights';
import { editOnGitHubUrl, withBase } from '../../utils/links';
import { Icon } from 'astro-icon/components';
import { site } from '../../config/site';

export const prerender = false;

const post = await getPublicInsight(Astro.params.slug ?? '');
if (!post) {
  Astro.response.status = 404;
}
const bodyHtml = post ? await renderInsightMarkdown(post.bodyMarkdown) : '';
const editUrl = post?.source === 'markdown' ? editOnGitHubUrl(`src/content/insights/${post.slug}.md`) : null;

const canonical = new URL(Astro.url.pathname, Astro.site ?? new URL(Astro.url)).toString();
const jsonLd = post ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.publishDate.toISOString(),
  ...(post.updatedDate ? { dateModified: post.updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: post.author || site.facilitator.name },
  publisher: { '@type': 'Organization', name: 'InnovaTech World' },
  mainEntityOfPage: canonical,
  url: canonical,
  ...(post.image ? { image: post.image } : {}),
} : null;
---

{post ? (
<BaseLayout
  title={post.title}
  description={post.description}
  image={post.image ?? '/og-default.png'}
  jsonLd={jsonLd ? [jsonLd] : []}
>
  <article class="post">
    <Breadcrumbs items={[{ label: 'Insights', href: '/insights/' }, { label: post.title }]} />
    <header class="post-header">
      <h1>{post.title}</h1>
      <p class="post-dek">{post.description}</p>
      <div class="post-meta">
        <time datetime={post.publishDate.toISOString()}>{formatDate(post.publishDate)}</time>
        <span>· {post.author}</span>
        {post.category && <span>· {post.category}</span>}
        {post.updatedDate && <span>· Updated {formatDate(post.updatedDate)}</span>}
      </div>
    </header>

    {post.image && <img class="post-featured-image" src={post.image} alt={post.imageAlt ?? ''} fetchpriority="high" />}
    <div class="prose" set:html={bodyHtml}></div>

    {
      editUrl && (
        <p class="post-edit no-print">
          <a href={editUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="lucide:pencil" width={15} height={15} aria-hidden="true" /> Edit this page on GitHub
          </a>
        </p>
      )
    }
  </article>

  <CodeCopy />
</BaseLayout>
) : (
  <BaseLayout title="Article not found" description="This Insights article could not be found.">
    <h1>Article not found</h1>
    <p>This article may have been removed or is not published.</p>
    <a class="btn btn-secondary" href={withBase('/insights/')}>Back to Insights</a>
  </BaseLayout>
)}

<style>
  .post {
    max-width: 72ch;
    margin-inline: auto;
  }
  .post-featured-image {
    display: block;
    width: 100%;
    max-height: 26rem;
    object-fit: cover;
    border-radius: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .post-header {
    margin: 1rem 0 1.5rem;
  }
  .post-header h1 {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 2.8rem);
  }
  .post-dek {
    color: var(--color-muted);
    font-size: 1.15rem;
    margin-top: 0.6rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--color-muted);
    margin-top: 0.75rem;
  }
  .post-edit {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
  }
  .post-edit a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted);
    text-decoration: none;
  }
  .post-edit a:hover {
    color: var(--color-blue-700);
    text-decoration: underline;
  }
</style>

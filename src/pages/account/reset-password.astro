---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Set a new password" description="Choose a new password for your account.">
  <div class="auth-page">
    <div class="card auth-card">
      <h1>Set a new password</h1>
      <p class="auth-sub">Enter a new password (at least 8 characters).</p>

      <form id="reset-form" hidden>
        <div class="field">
          <label for="password">New password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />
        </div>
        <p id="auth-error" class="auth-error" role="alert" hidden></p>
        <p id="auth-ok" class="auth-ok" role="status" hidden></p>
        <button type="submit" class="btn btn-primary">Save password</button>
      </form>

      <p id="reset-wait" class="auth-sub">Open this page from the reset link in your email.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .auth-page { max-width: 28rem; margin: 2rem auto; }
  .auth-card { padding: 2rem; }
  .auth-card h1 { font-size: 1.8rem; }
  .auth-sub { color: var(--color-muted); margin: 0.3rem 0 1.25rem; }
  .field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem; }
  .field label { font-weight: 600; font-size: 0.9rem; }
  .field input {
    font: inherit; padding: 0.6rem 0.75rem; border: 1px solid var(--color-border);
    border-radius: 0.5rem; background: var(--surface); color: var(--color-ink);
  }
  .auth-error { color: var(--color-danger); font-size: 0.9rem; }
  .auth-ok { color: var(--color-success); font-size: 0.9rem; }
  #reset-form button { width: 100%; }
</style>

<script>
  import { getSupabase, isPortalEnabled } from '../../lib/supabase';
  import { updatePassword } from '../../lib/auth';
  import { withBase } from '../../utils/links';

  const form = document.getElementById('reset-form') as HTMLFormElement | null;
  const wait = document.getElementById('reset-wait')!;
  const errEl = document.getElementById('auth-error')!;
  const okEl = document.getElementById('auth-ok')!;

  async function init() {
    if (!isPortalEnabled || !form) {
      wait.textContent = 'The portal is not configured.';
      return;
    }
    const sb = getSupabase()!;
    // A valid recovery session must exist (from the email link).
    let ready = false;
    for (let i = 0; i < 10; i++) {
      const { data } = await sb.auth.getSession();
      if (data.session) { ready = true; break; }
      await new Promise((r) => setTimeout(r, 300));
    }
    if (!ready) {
      wait.innerHTML =
        'This reset link is invalid or has expired. ' +
        '<a href="' + withBase('/login/') + '">Request a new password reset</a> from the login page.';
      return;
    }
    wait.hidden = true;
    form.hidden = false;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.hidden = true;
      okEl.hidden = true;
      const pw = (document.getElementById('password') as HTMLInputElement).value;
      const r = await updatePassword(pw);
      if (r.ok) {
        okEl.textContent = 'Password updated. Redirecting…';
        okEl.hidden = false;
        setTimeout(() => window.location.replace(withBase('/account/')), 1000);
      } else {
        errEl.textContent = r.error;
        errEl.hidden = false;
      }
    });
  }
  init();
</script>

---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { certificates } from '../data/certificates';

// Only the minimum fields are sent to the client (id, name, course, issued).
const records = certificates.map((c) => ({ id: c.id, name: c.name, course: c.course, issued: c.issued }));
---

<BaseLayout
  title="Verify a Certificate"
  description="Check that an InnovaTech World certificate is genuine by entering its certificate ID."
>
  <header class="page-head">
    <span class="eyebrow">Verification</span>
    <h1>Verify a certificate</h1>
    <p>Enter the certificate code printed on an InnovaTech World certificate to confirm it's genuine.</p>
  </header>

  <form id="verify-form" class="verify-form">
    <label for="cert-id" class="sr-only">Certificate ID</label>
    <input id="cert-id" name="id" type="text" placeholder="e.g. ITW-DA-2026-0001" autocomplete="off" required />
    <button type="submit" class="btn btn-primary">
      <Icon name="lucide:shield-check" width={18} height={18} aria-hidden="true" />
      Verify
    </button>
  </form>

  <div id="verify-result" class="verify-result" role="status" aria-live="polite"></div>

  <script type="application/json" id="cert-data" set:html={JSON.stringify(records)} />
</BaseLayout>

<script>
  import { isPortalEnabled } from '../lib/portal-config';

  type Cert = {
    code: string;
    student_name: string;
    course: string;
    duration?: string | null;
    grade?: string | null;
    issued_at: string;
  };

  const dataEl = document.getElementById('cert-data');
  const form = document.getElementById('verify-form') as HTMLFormElement | null;
  const input = document.getElementById('cert-id') as HTMLInputElement | null;
  const result = document.getElementById('verify-result');

  // Static fallback (used only when Supabase isn't configured).
  let fallback: Array<{ id: string; name: string; course: string; issued: string }> = [];
  try {
    fallback = JSON.parse(dataEl?.textContent || '[]');
  } catch {
    fallback = [];
  }

  const fmt = (iso: string) => {
    const d = new Date(iso);
    return isNaN(d.getTime())
      ? iso
      : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  };
  const esc = (s: string) =>
    String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

  function showValid(c: Cert) {
    result!.className = 'verify-result ok';
    result!.innerHTML =
      `<p class="vr-title">✓ Valid certificate</p>
       <dl>
         <div><dt>Name</dt><dd>${esc(c.student_name)}</dd></div>
         <div><dt>Course</dt><dd>${esc(c.course)}</dd></div>
         ${c.duration ? `<div><dt>Duration</dt><dd>${esc(c.duration)}</dd></div>` : ''}
         ${c.grade ? `<div><dt>Result</dt><dd>${esc(c.grade)}</dd></div>` : ''}
         <div><dt>Issued</dt><dd>${esc(fmt(c.issued_at))}</dd></div>
         <div><dt>Certificate code</dt><dd>${esc(c.code)}</dd></div>
       </dl>`;
  }
  function showNotFound() {
    result!.className = 'verify-result bad';
    result!.innerHTML =
      `<p class="vr-title">No match found</p>
       <p>We couldn't find a certificate with that code. Check it and try again, or contact us.</p>`;
  }

  if (form && input && result) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      result.className = 'verify-result';
      result.textContent = 'Checking…';

      if (isPortalEnabled) {
        const { verifyCertificate } = await import('../lib/certificates');
        const match = await verifyCertificate(q);
        if (match) showValid(match);
        else showNotFound();
      } else {
        const m = fallback.find((r) => r.id.toLowerCase() === q.toLowerCase());
        if (m) showValid({ code: m.id, student_name: m.name, course: m.course, issued_at: m.issued });
        else showNotFound();
      }
    });
  }
</script>

<style>
  .page-head {
    margin: 0.5rem 0 1.5rem;
  }
  .page-head h1 {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
  }
  .page-head p {
    color: var(--color-muted);
    font-size: 1.1rem;
    margin-top: 0.5rem;
    max-width: 55ch;
  }
  .verify-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 32rem;
  }
  .verify-form input {
    flex: 1;
    min-width: 12rem;
    font: inherit;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--color-ink);
  }
  .verify-result {
    max-width: 32rem;
    margin-top: 1.25rem;
  }
  .verify-result:empty {
    display: none;
  }
  .verify-result.ok,
  .verify-result.bad {
    padding: 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
  }
  .verify-result.ok {
    border-color: var(--color-success);
    background: var(--cl-bg-tip);
  }
  .verify-result.bad {
    border-color: var(--color-warning);
    background: var(--cl-bg-warning);
  }
  .vr-title {
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .verify-result dl {
    display: grid;
    gap: 0.4rem;
    margin: 0;
  }
  .verify-result dl div {
    display: flex;
    gap: 0.5rem;
  }
  .verify-result dt {
    font-weight: 600;
    min-width: 7rem;
    color: var(--color-muted);
  }
</style>

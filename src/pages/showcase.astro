---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllCourses } from '../utils/courses';

const courses = await getAllCourses();
const courseOptions = courses.map((c) => ({ slug: c.data.slug, title: c.data.title }));
const titleBySlug: Record<string, string> = Object.fromEntries(
  courseOptions.map((c) => [c.slug, c.title]),
);
---

<BaseLayout
  title="Student Showcase"
  description="Projects and portfolios built by Innovatech World students."
>
  <div class="showcase-page">
    <header class="page-head">
      <h1>Student showcase</h1>
      <p>Real projects built by Innovatech World students, shared with their permission.</p>
    </header>

    <div data-showcase-grid>
      <div class="card empty-state">
        <Icon name="lucide:sparkles" width={28} height={28} aria-hidden="true" />
        <h2>Student projects will appear here</h2>
        <p>
          Finished a project you're proud of? Submit it below - we only showcase work
          with your written permission.
        </p>
      </div>
    </div>

    <section class="card submit-wrap">
      <h2 class="submit-title">Submit your project</h2>
      <p class="submit-lead">
        Share a finished project to be featured here. We review every submission and only
        publish it with your permission.
      </p>
      <div data-submit-area><p class="muted">Loading…</p></div>
    </section>
  </div>

  <script type="application/json" id="course-opts" set:html={JSON.stringify(courseOptions)} />
  <script type="application/json" id="course-titles" set:html={JSON.stringify(titleBySlug)} />
</BaseLayout>

<style is:global>
  .showcase-page .page-head { margin: 0.5rem 0 1.5rem; }
  .showcase-page .page-head h1 { font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem); }
  .showcase-page .page-head p { color: var(--color-muted); font-size: 1.1rem; margin-top: 0.5rem; max-width: 55ch; }

  .showcase-page .empty-state {
    text-align: center; padding: 2.5rem 1.5rem; max-width: 36rem; margin-inline: auto;
    color: var(--color-blue-600);
  }
  .showcase-page .empty-state h2 { font-size: 1.3rem; margin: 0.75rem 0 0.5rem; }
  .showcase-page .empty-state p { color: var(--color-muted); margin: 0; }

  .showcase-page .showcase-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  .showcase-page .showcase-card {
    display: flex; flex-direction: column; gap: 0.5rem; padding: 1.4rem;
    text-decoration: none; color: inherit;
  }
  .showcase-page .showcase-course { align-self: flex-start; }
  .showcase-page .showcase-card h2 { font-size: 1.25rem; }
  .showcase-page .showcase-card p { color: var(--color-muted); }
  .showcase-page .showcase-by {
    display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 600;
    color: var(--color-blue-700); margin-top: auto;
  }

  .showcase-page .submit-wrap { margin-top: 2rem; padding: 1.6rem 1.5rem; }
  .showcase-page .submit-title { font-size: 1.3rem; margin: 0 0 0.35rem; }
  .showcase-page .submit-lead { color: var(--color-muted); margin: 0 0 1.1rem; max-width: 60ch; }
  .showcase-page .sc-form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.9rem; max-width: 42rem; }
  .showcase-page .sc-form label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.9rem; font-weight: 600; }
  .showcase-page .sc-form input,
  .showcase-page .sc-form select,
  .showcase-page .sc-form textarea {
    font: inherit; font-weight: 400; padding: 0.55rem 0.7rem; border: 1px solid var(--color-border);
    border-radius: 0.5rem; background: var(--surface); color: var(--color-ink); width: 100%; box-sizing: border-box;
  }
  .showcase-page .sc-form textarea { resize: vertical; }
  .showcase-page .sc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .showcase-page .sc-login { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem; }
  .showcase-page .sc-mine { margin-top: 1.4rem; }
  .showcase-page .sc-mine h3 { font-size: 1rem; margin: 0 0 0.6rem; }
  .showcase-page .sc-mine-list { display: grid; gap: 0.5rem; }
  .showcase-page .sc-mine-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem;
    padding: 0.6rem 0.8rem; border: 1px solid var(--color-border); border-radius: 0.5rem;
    font-size: 0.9rem;
  }
  .showcase-page .sc-mine-row .title { font-weight: 600; }
  .showcase-page .sc-status {
    font-size: 0.72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    padding: 0.15rem 0.55rem; border-radius: 999px; margin-left: auto;
  }
  .showcase-page .sc-status.approved { background: #dcfce7; color: #166534; }
  .showcase-page .sc-status.pending { background: var(--color-blue-50); color: var(--color-blue-700); }
  .showcase-page .sc-status.rejected { background: #fee2e2; color: #991b1b; }
  .showcase-page .sc-msg.ok { color: var(--color-success); font-size: 0.9rem; }
  .showcase-page .sc-msg.err { color: var(--color-danger); font-size: 0.9rem; }

  @media (min-width: 760px) {
    .showcase-page .showcase-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  import { isPortalEnabled } from '../lib/portal-config';
  import { withBase } from '../utils/links';

  const gridEl = document.querySelector<HTMLElement>('[data-showcase-grid]');
  const submitArea = document.querySelector<HTMLElement>('[data-submit-area]');
  const esc = (s: string) =>
    String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

  type Opt = { slug: string; title: string };
  let courseOpts: Opt[] = [];
  let titleBySlug: Record<string, string> = {};
  try { courseOpts = JSON.parse(document.getElementById('course-opts')?.textContent || '[]'); } catch {}
  try { titleBySlug = JSON.parse(document.getElementById('course-titles')?.textContent || '{}'); } catch {}

  type Approved = { name: string; course_slug: string | null; project_title: string; summary: string | null; url: string };

  function renderGrid(items: Approved[]) {
    if (!gridEl || !items.length) return; // keep the empty-state card
    gridEl.innerHTML =
      '<div class="showcase-grid">' +
      items.map((s) => `
        <a class="card card-link showcase-card" href="${esc(s.url)}" target="_blank" rel="noopener noreferrer">
          ${s.course_slug ? `<span class="showcase-course chip">${esc(titleBySlug[s.course_slug] || s.course_slug)}</span>` : ''}
          <h2>${esc(s.project_title)}</h2>
          ${s.summary ? `<p>${esc(s.summary)}</p>` : ''}
          <span class="showcase-by">by ${esc(s.name)}</span>
        </a>`).join('') +
      '</div>';
  }

  const statusLabel: Record<string, string> = { approved: 'Featured', pending: 'In review', rejected: 'Not published' };

  function formHtml(): string {
    const opts = ['<option value="">- none / general -</option>']
      .concat(courseOpts.map((c) => `<option value="${esc(c.slug)}">${esc(c.title)}</option>`))
      .join('');
    return `
      <form data-sc-form class="sc-form">
        <label>Project title <input data-sc-title type="text" required maxlength="120" placeholder="e.g. Bayelsa Market Price Tracker" /></label>
        <label>Related course (optional)
          <select data-sc-course>${opts}</select>
        </label>
        <label>Project link <input data-sc-url type="url" required placeholder="https://..." /></label>
        <label>Short summary (optional) <textarea data-sc-summary rows="3" maxlength="300" placeholder="One or two sentences about what it does."></textarea></label>
        <div class="sc-actions">
          <button type="submit" class="btn btn-primary">Submit for review</button>
          <span data-sc-msg class="sc-msg"></span>
        </div>
      </form>
      <div class="sc-mine" data-sc-mine></div>`;
  }

  if (isPortalEnabled && submitArea) {
    const [{ getApprovedShowcase }, auth, portal] = await Promise.all([
      import('../lib/showcase'),
      import('../lib/auth'),
      import('../lib/portal'),
    ]);

    getApprovedShowcase().then(renderGrid);

    const renderMine = async () => {
      const box = submitArea.querySelector<HTMLElement>('[data-sc-mine]');
      if (!box) return;
      const mine = await portal.getMyShowcaseProjects();
      if (!mine.length) { box.innerHTML = ''; return; }
      box.innerHTML =
        '<h3>Your submissions</h3><div class="sc-mine-list">' +
        mine.map((m) => `<div class="sc-mine-row">
          <span class="title">${esc(m.project_title)}</span>
          <span class="sc-status ${m.status}">${statusLabel[m.status] || m.status}</span>
        </div>`).join('') +
        '</div>';
    };

    const bindForm = () => {
      const form = submitArea.querySelector<HTMLFormElement>('[data-sc-form]');
      if (!form) return;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = form.querySelector<HTMLElement>('[data-sc-msg]')!;
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        msg.textContent = 'Submitting…'; msg.className = 'sc-msg';
        btn.disabled = true;
        const r = await portal.submitShowcaseProject({
          projectTitle: (form.querySelector('[data-sc-title]') as HTMLInputElement).value,
          courseSlug: (form.querySelector('[data-sc-course]') as HTMLSelectElement).value,
          url: (form.querySelector('[data-sc-url]') as HTMLInputElement).value,
          summary: (form.querySelector('[data-sc-summary]') as HTMLTextAreaElement).value,
        });
        btn.disabled = false;
        if (r.ok) {
          msg.textContent = 'Thanks! Your project was submitted for review.'; msg.className = 'sc-msg ok';
          form.reset();
          renderMine();
        } else {
          msg.textContent = r.error; msg.className = 'sc-msg err';
        }
      });
    };

    // Supabase runs auth callbacks inside a lock; defer so queries see a live token.
    auth.onAuthChange((user) => setTimeout(() => {
      if (!user) {
        submitArea.innerHTML =
          `<div class="sc-login"><p class="muted" style="margin:0">Log in to submit your project for review.</p>` +
          `<a class="btn btn-primary" href="${withBase('/login/')}">Log in</a></div>`;
        return;
      }
      submitArea.innerHTML = formHtml();
      bindForm();
      renderMine();
    }, 0));
  } else if (submitArea) {
    submitArea.innerHTML = '<p class="muted">Project submissions open once the student portal is set up.</p>';
  }
</script>

---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, isTodo } from '../config/site';
import { services } from '../data/services';
import { withBase } from '../utils/links';

const calendly = !isTodo(site.contact.calendly) ? site.contact.calendly : null;

const serviceSchema = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.description,
  provider: { '@type': 'Organization', name: 'InnovaTech World' },
  areaServed: 'Worldwide',
}));

const faqs = [
  {
    q: 'How do your service packages work?',
    a: 'Each service has three packages: Basic, Advanced and Premium. Pick the one that fits your needs, book a short call to confirm the scope, and we agree a start date. Prices on this page are a guide; the final quote depends on your exact requirements.',
  },
  {
    q: 'Can I get a custom package?',
    a: 'Yes. If none of the three packages fits, book a consultation and we will scope a custom package and quote for your project.',
  },
  {
    q: 'What currency are the prices in, and how do I pay?',
    a: 'Each package is a fixed one-time price in Nigerian Naira (₦). You can also hire a service by the hour for contract or ongoing work; hourly rates are quoted in US Dollars (USD) and paid in the current Naira equivalent. We confirm the scope and terms in writing before we start.',
  },
  {
    q: 'Can I hire trained talent instead of a done-for-you project?',
    a: 'Yes. Alongside our done-for-you services, we recruit and place vetted, InnovaTech-trained talent into your team for a role. Tell us the role on a call and we will match you with the right person.',
  },
  {
    q: 'Do you offer refunds?',
    a: 'Deposits cover work we schedule and begin, so they are generally non-refundable once a project has started. If we have not started, or we cannot deliver what was agreed, you may be entitled to a refund. Full details are in our refunds policy.',
  },
  {
    q: 'How long does a project take?',
    a: 'It depends on the package and scope. We give you a realistic timeline in your quote before you commit, and we keep you updated as we go.',
  },
  {
    q: 'Who owns the work when it is done?',
    a: 'Once a project is fully paid, the final deliverables are yours. We hand over the files and, where relevant, show you how to manage them.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Services"
  description="Web development, WordPress, data analysis, automation, graphics design, SEO/AEO/GEO and virtual assistance from InnovaTech World, with clear Basic, Advanced and Premium packages. Hire trained talent too."
  jsonLd={[...serviceSchema, faqJsonLd]}
>
  <header class="page-head">
    <span class="eyebrow">InnovaTech World</span>
    <h1>Services</h1>
    <p>
      InnovaTech World is a digital agency, a training academy and a talent partner. Get the work done for
      you, or hire trained talent for your team. Every service comes in clear Basic, Advanced and Premium
      packages.
    </p>
    {calendly && (
      <a class="btn btn-primary" href={calendly} target="_blank" rel="noopener noreferrer">Book a free consultation</a>
    )}
  </header>

  <p class="svc-currency-note" role="note">
    <strong>Note:</strong> each package below is a fixed one-time price in Nigerian Naira (₦). You can also
    hire any service by the hour for contract or ongoing work — those rates are quoted in US Dollars ($) and
    paid in the current Naira equivalent.
  </p>

  <div class="svc-list">
    {services.map((s) => (
      <section class="svc" id={s.slug} aria-labelledby={`${s.slug}-title`}>
        <div class="svc-head">
          <span class="svc-icon" aria-hidden="true"><Icon name={s.icon} width={26} height={26} /></span>
          <div>
            <h2 id={`${s.slug}-title`}>{s.title}</h2>
            <p class="svc-tagline">{s.tagline}</p>
          </div>
        </div>
        <p class="svc-desc">{s.description}</p>
        <p class="svc-hourly" data-service-hourly={s.slug} hidden></p>
        <div class="svc-plans" data-service-plans={s.slug}>
          <p class="muted">Loading packages…</p>
        </div>
      </section>
    ))}
  </div>

  <section class="svc-talent" aria-labelledby="talent-title">
    <span class="eyebrow">For employers</span>
    <h2 id="talent-title">Hire trained talent</h2>
    <p>
      Need someone on your team rather than a one-off project? We recruit, train and vet talent across web
      development, data analysis, virtual assistance, design and more, then match them to your role. You get
      a work-ready professional without the long hiring search.
    </p>
    <ul class="svc-talent-points">
      <li><Icon name="lucide:check" width={18} height={18} aria-hidden="true" /> Vetted, InnovaTech-trained candidates</li>
      <li><Icon name="lucide:check" width={18} height={18} aria-hidden="true" /> Matched to your role and budget</li>
      <li><Icon name="lucide:check" width={18} height={18} aria-hidden="true" /> Remote, part-time or full-time</li>
    </ul>
    <div class="svc-talent-cta">
      {calendly && (
        <a class="btn btn-primary" href={calendly} target="_blank" rel="noopener noreferrer">Book a hiring call</a>
      )}
      <a class="btn btn-secondary" href={withBase('/contact/')}>Tell us your role</a>
    </div>
  </section>

  <section class="service-faq" aria-labelledby="service-faq-title">
    <h2 id="service-faq-title">Frequently asked questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p set:html={f.q.includes('refund')
          ? f.a.replace('refunds policy', `<a href="${withBase('/refunds/')}">refunds policy</a>`)
          : f.a} />
      </details>
    ))}
    <p class="service-faq-more">
      See our full <a href={withBase('/refunds/')}>refunds policy</a> and <a href={withBase('/terms/')}>terms</a>.
    </p>
  </section>

  <section class="service-cta" aria-labelledby="service-contact-title">
    <h2 id="service-contact-title">Ready to start?</h2>
    <p>Book a free consultation or send us a message, and we will recommend the right package for you.</p>
    <div class="service-cta-actions">
      {calendly && (
        <a class="btn btn-primary" href={calendly} target="_blank" rel="noopener noreferrer">Book a consultation</a>
      )}
      <a class="btn btn-secondary" href={withBase('/contact/')}>Contact us</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { getServicePlans, getServiceRates } from '../lib/payments';
  import { site, isTodo } from '../config/site';
  import { withBase } from '../utils/links';

  const calendly = !isTodo(site.contact.calendly) ? site.contact.calendly : null;
  const bookHref = calendly || withBase('/contact/');
  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
  const order: Record<string, number> = { basic: 1, advanced: 2, premium: 3 };

  // Amounts are stored in the currency's minor units (USD -> cents, NGN -> kobo).
  const money = (minor: number, currency: string) => {
    const major = Math.round((minor || 0) / 100);
    return currency === 'USD'
      ? '$' + major.toLocaleString('en-US')
      : '₦' + major.toLocaleString('en-NG');
  };

  (async () => {
    const [plans, rates] = await Promise.all([getServicePlans(), getServiceRates()]);

    // Per-service hourly rate line (for contract / ongoing hire).
    for (const el of Array.from(document.querySelectorAll<HTMLElement>('[data-service-hourly]'))) {
      const rate = rates.find((r) => r.service_slug === el.dataset.serviceHourly);
      if (rate && rate.hourly_price_kobo) {
        el.innerHTML = `Prefer to hire by the hour (contract or ongoing)? <strong>${money(rate.hourly_price_kobo, rate.currency)}/hr</strong>, paid in the Naira equivalent.`;
        el.hidden = false;
      }
    }

    for (const box of Array.from(document.querySelectorAll<HTMLElement>('[data-service-plans]'))) {
      const slug = box.dataset.servicePlans!;
      const list = plans
        .filter((p) => p.service_slug === slug)
        .sort((a, b) => (order[a.plan] || 9) - (order[b.plan] || 9));

      if (!list.length) {
        box.innerHTML = `<p class="muted">Pricing available on request. <a href="${bookHref}">Book a call</a> for a quote.</p>`;
        continue;
      }

      box.innerHTML = list.map((p) => `
        <article class="svc-plan${p.plan === 'advanced' ? ' is-popular' : ''}">
          ${p.plan === 'advanced' ? '<span class="svc-badge">Most popular</span>' : ''}
          <h3>${esc(cap(p.plan))}</h3>
          <div class="svc-price">${p.fixed_price_kobo ? money(p.fixed_price_kobo, 'NGN') : 'On request'}<span class="svc-per">${p.fixed_price_kobo ? 'one-time' : ''}</span></div>
          <ul>${(p.features || []).map((f) => `<li>${esc(f)}</li>`).join('')}</ul>
          <a class="btn ${p.plan === 'advanced' ? 'btn-primary' : 'btn-secondary'}" href="${bookHref}"${calendly ? ' target="_blank" rel="noopener noreferrer"' : ''}>Request ${esc(cap(p.plan))}</a>
        </article>`).join('');
    }
  })();
</script>

<style>
  .page-head { margin: 0.5rem 0 1.5rem; }
  .page-head h1 { font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem); }
  .page-head p { color: var(--color-muted); font-size: 1.1rem; max-width: 60ch; }
  .page-head .btn { margin-top: 1rem; }

  .svc-currency-note {
    margin: 0 0 1.25rem;
    padding: 0.75rem 1rem;
    border-left: 4px solid var(--color-burgundy-600);
    background: var(--color-burgundy-50);
    color: var(--color-ink);
    border-radius: 0 0.5rem 0.5rem 0;
    font-size: 0.95rem;
  }

  .svc-list { display: flex; flex-direction: column; gap: 1.75rem; margin-top: 1rem; }
  .svc {
    border: 1px solid var(--color-border);
    border-radius: 0.8rem;
    background: var(--surface);
    padding: 1.4rem;
  }
  .svc-head { display: flex; align-items: flex-start; gap: 0.9rem; }
  .svc-icon {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 3rem; height: 3rem; border-radius: 0.6rem;
    background: var(--color-burgundy-600); color: #fff;
  }
  .svc-head h2 { margin: 0; font-size: 1.4rem; }
  .svc-tagline { margin: 0.15rem 0 0; color: var(--color-burgundy-text); font-weight: 600; }
  .svc-desc { color: var(--color-muted); margin: 0.9rem 0 1rem; max-width: 70ch; }
  .svc-hourly {
    margin: 0 0 1.1rem; padding: 0.6rem 0.8rem; font-size: 0.95rem; color: var(--color-ink);
    background: var(--surface-2); border: 1px dashed var(--color-border); border-radius: 0.5rem;
  }

  .svc-plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 760px) { .svc-plans { grid-template-columns: 1fr; } }

  /* Cards below are injected via client JS, so their styles must be :global
     (scoped selectors never match innerHTML-created elements). */
  .svc-plans :global(.svc-plan) {
    position: relative;
    display: flex; flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: var(--surface-2);
    padding: 1.2rem 1.1rem;
  }
  .svc-plans :global(.svc-plan.is-popular) { border-color: var(--color-burgundy-600); border-width: 2px; }
  .svc-plans :global(.svc-badge) {
    position: absolute; top: -0.7rem; left: 1.1rem;
    background: var(--color-burgundy-600); color: #fff;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.03em;
    padding: 0.2rem 0.55rem; border-radius: 999px; text-transform: uppercase;
  }
  .svc-plans :global(.svc-plan h3) { margin: 0.3rem 0 0.4rem; font-size: 1.15rem; }
  .svc-plans :global(.svc-price) { font-size: 1.7rem; font-weight: 700; color: var(--color-burgundy-text); margin-bottom: 0.2rem; }
  .svc-plans :global(.svc-price .svc-per) { font-size: 0.9rem; font-weight: 600; color: var(--color-muted); }
  .svc-plans :global(.svc-fixed) { font-size: 0.9rem; color: var(--color-muted); margin-bottom: 0.9rem; }
  .svc-plans :global(.svc-plan ul) { list-style: none; margin: 0 0 1.2rem; padding: 0; display: grid; gap: 0.45rem; }
  .svc-plans :global(.svc-plan li) { position: relative; padding-left: 1.4rem; color: var(--color-ink); font-size: 0.92rem; }
  .svc-plans :global(.svc-plan li)::before {
    content: '✓'; position: absolute; left: 0; color: var(--color-burgundy-text); font-weight: 700;
  }
  .svc-plans :global(.svc-plan .btn) { margin-top: auto; width: 100%; }

  .svc-talent {
    margin-top: 2.5rem; padding: 1.6rem;
    border-radius: 0.8rem;
    background: var(--color-blue-900);
    color: #fff;
  }
  .svc-talent .eyebrow { color: #cdd9ea; }
  .svc-talent h2 { font-size: 1.5rem; margin: 0.3rem 0 0.6rem; color: #fff; }
  .svc-talent p { color: #d7e0ee; max-width: 65ch; }
  .svc-talent-points { list-style: none; margin: 1rem 0 1.3rem; padding: 0; display: grid; gap: 0.5rem; }
  .svc-talent-points li { display: flex; align-items: center; gap: 0.5rem; }
  .svc-talent-points svg { color: #9ec7f0; flex: 0 0 auto; }
  .svc-talent-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .service-faq { margin-top: 2.5rem; }
  .service-faq h2 { font-size: 1.5rem; }
  .service-faq details { border-bottom: 1px solid var(--color-border); padding: 0.9rem 0; }
  .service-faq summary { cursor: pointer; font-weight: 600; }
  .service-faq p { color: var(--color-muted); margin: 0.5rem 0 0; }
  .service-faq-more { margin-top: 1rem; }

  .service-cta {
    margin-top: 2.5rem;
    padding: 1.6rem;
    border-left: 4px solid var(--color-burgundy-600);
    background: var(--surface-2);
    border-radius: 0 0.6rem 0.6rem 0;
  }
  .service-cta h2 { font-size: 1.3rem; margin-top: 0; }
  .service-cta p { color: var(--color-muted); }
  .service-cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
</style>

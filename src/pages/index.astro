---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getAllCourses, getLessons, lessonSlug } from '../utils/courses';
import { testimonials } from '../data/testimonials';
import { site } from '../config/site';
import { withBase } from '../utils/links';

const courses = await getAllCourses();
const available = courses.filter((c) => c.data.status === 'available');
const soon = courses.filter((c) => c.data.status !== 'available');

// Lightweight index for the "continue where you left off" band (client-side).
const courseIndex = await Promise.all(
  available.map(async (c) => ({
    slug: c.data.slug,
    title: c.data.title,
    href: withBase(`/courses/${c.data.slug}/`),
    lessons: (await getLessons(c.data.slug)).map((l) => ({
      slug: lessonSlug(l),
      title: l.data.title,
      href: withBase(`/courses/${c.data.slug}/${lessonSlug(l)}/`),
    })),
  })),
);
const featured = [
  ...available.sort((a, b) => Number(b.data.featured) - Number(a.data.featured)),
  ...soon,
].slice(0, 6);

const steps = [
  { icon: 'calendar-days', title: 'Weekly lessons', text: 'Follow one clear, written lesson each week at your own pace.' },
  { icon: 'laptop', title: 'Hands-on assignments', text: 'Practise on real datasets and build work you can show.' },
  { icon: 'users', title: 'Mentoring sessions', text: 'Meet your facilitator for live problem-solving and feedback.' },
  { icon: 'folder-git-2', title: 'Portfolio', text: 'Finish with projects and a GitHub profile that prove your skills.' },
];
const values = [
  { icon: 'wrench', title: 'Practical and project-based', text: 'You learn by doing, not by memorising theory.' },
  { icon: 'sprout', title: 'Beginner-friendly', text: 'No experience needed. We start from zero and build up.' },
  { icon: 'globe-2', title: 'Local mentorship, global skills', text: 'In-person support in Yenagoa, skills that travel anywhere.' },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-text">
      <span class="eyebrow">InnovaTech World</span>
      <h1>{site.tagline}</h1>
      <p class="hero-lead">
        Practical, beginner-friendly technology training - written lessons, real datasets, and
        live mentoring to get you job-ready.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={withBase('/courses/')}>
          Explore Academy
          <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
        </a>
        <WhatsAppButton variant="secondary" />
      </div>
      <ul class="hero-meta">
        <li><Icon name="lucide:check" width={16} height={16} aria-hidden="true" /> Project-based lessons</li>
        <li><Icon name="lucide:check" width={16} height={16} aria-hidden="true" /> Live mentoring</li>
        <li><Icon name="lucide:check" width={16} height={16} aria-hidden="true" /> Portfolio-ready</li>
      </ul>
    </div>
    <div class="hero-art">
      <img
        src={withBase('/images/hero.jpg')}
        alt="An InnovaTech World student ready to learn"
        class="hero-photo"
        loading="eager"
        fetchpriority="high"
        onerror="this.closest('.hero-art').remove()"
      />
    </div>
  </section>

  <!-- Continue where you left off (shown by JS only if there's saved progress) -->
  <section id="continue" class="section continue" hidden aria-label="Continue learning">
    <h2>Jump back in</h2>
    <div class="continue-grid" id="continue-grid"></div>
  </section>
  <script type="application/json" id="itw-course-index" set:html={JSON.stringify(courseIndex)} />
  <script>
    import { getCompleted } from '../scripts/progress';
    type L = { slug: string; title: string; href: string };
    type C = { slug: string; title: string; href: string; lessons: L[] };
    const el = document.getElementById('itw-course-index');
    const grid = document.getElementById('continue-grid');
    const section = document.getElementById('continue');
    if (el && grid && section) {
      let courses: C[] = [];
      try {
        courses = JSON.parse(el.textContent || '[]');
      } catch {
        courses = [];
      }
      const cards: string[] = [];
      for (const c of courses) {
        const done = getCompleted(c.slug);
        if (done.size === 0) continue;
        const total = c.lessons.length;
        const next = c.lessons.find((l) => !done.has(l.slug));
        const pct = total ? Math.round((done.size / total) * 100) : 0;
        const target = next ?? { href: c.href, title: 'Review the course' };
        const verb = next ? 'Continue' : 'Revisit';
        cards.push(
          `<a class="card card-link continue-card" href="${target.href}">
             <span class="continue-course">${c.title}</span>
             <span class="continue-next">${verb}: ${target.title}</span>
             <span class="continue-bar"><span style="width:${pct}%"></span></span>
             <span class="continue-pct">${pct}% complete</span>
           </a>`,
        );
      }
      if (cards.length) {
        grid.innerHTML = cards.join('');
        section.hidden = false;
      }
    }
  </script>

  <!-- Featured courses -->
  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Academy</span>
        <h2>Start with what's ready now</h2>
      </div>
      <a class="section-link" href={withBase('/courses/')}>
        Browse Academy
        <Icon name="lucide:arrow-right" width={15} height={15} aria-hidden="true" />
      </a>
    </div>
    <div class="card-grid">
      {featured.map((course) => <CourseCard course={course} />)}
    </div>
  </section>

  <!-- How learning works -->
  <section class="section section-alt">
    <div class="section-head section-head--center">
      <span class="eyebrow">How it works</span>
      <h2>A simple weekly rhythm</h2>
    </div>
    <div class="step-grid">
      {
        steps.map((s, i) => (
          <div class="step">
            <span class="step-num">{i + 1}</span>
            <Icon name={`lucide:${s.icon}`} width={26} height={26} aria-hidden="true" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Why InnovaTech -->
  <section class="section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Why us</span>
        <h2>Built around getting you job-ready</h2>
      </div>
    </div>
    <div class="value-grid">
      {
        values.map((v) => (
          <div class="value">
            <span class="value-icon" aria-hidden="true">
              <Icon name={`lucide:${v.icon}`} width={24} height={24} />
            </span>
            <div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Community band -->
  <section class="section community">
    <div class="community-media">
      <img
        src={withBase('/images/community.jpg')}
        alt="InnovaTech World learners during a mentoring session"
        loading="lazy"
        onerror="this.closest('.community').remove()"
      />
    </div>
    <div class="community-text">
      <span class="eyebrow">Community</span>
      <h2>Learn alongside a supportive community</h2>
      <p>
        You're never on your own. Small-group mentorship means real people, real feedback, and
        encouragement - from Yenagoa to wherever you're headed.
      </p>
      <a class="btn btn-secondary" href={withBase('/about/')}>
        About our training
        <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- Testimonials (shown only when real, permitted entries exist) -->
  {
    testimonials.length > 0 && (
      <section class="section">
        <h2>What students say</h2>
        <div class="testimonial-grid">
          {testimonials.map((t) => (
            <figure class="card testimonial">
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <strong>{t.name}</strong>
                {t.detail && <span>{t.detail}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <!-- CTA band -->
  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Ready to start?</h2>
        <p>Talk to us on WhatsApp and we'll help you pick the right course.</p>
      </div>
      <WhatsAppButton variant="secondary" label="Talk to us on WhatsApp" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    padding: 2rem 0 1rem;
    margin-top: 0.5rem;
  }
  .hero-text h1 {
    font-size: clamp(2.3rem, 1.4rem + 3.6vw, 3.6rem);
    line-height: 1.08;
  }
  .hero-lead {
    color: var(--color-muted);
    font-size: 1.2rem;
    line-height: 1.6;
    margin-top: 1.1rem;
    max-width: 46ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-muted);
  }
  .hero-meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-meta :global(svg) {
    color: var(--color-blue-600);
  }
  .hero-art {
    display: flex;
    justify-content: center;
  }
  .hero-photo {
    width: 100%;
    max-width: 460px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1rem;
    display: block;
    border: 1px solid var(--color-border);
    box-shadow: 0 18px 40px rgba(4, 23, 43, 0.12);
  }

  .section {
    margin-top: 4.5rem;
  }
  .section h2 {
    font-size: clamp(1.65rem, 1.3rem + 1.5vw, 2.15rem);
  }
  .section > h2 {
    margin-bottom: 1.5rem;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .section-head h2 {
    margin-bottom: 0;
  }
  .section-head--center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .section-head--center .eyebrow {
    margin-bottom: 0.5rem;
  }
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }
  .section-link:hover {
    text-decoration: underline;
  }
  .section-alt {
    background: var(--color-blue-50);
    border: 1px solid var(--color-blue-100);
    border-radius: 1.25rem;
    padding: 3rem 1.5rem;
  }

  .continue-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .continue-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.25rem;
    text-decoration: none;
    color: inherit;
  }
  .continue-course {
    font-weight: 700;
  }
  .continue-next {
    color: var(--color-blue-700);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .continue-bar {
    height: 0.4rem;
    background: var(--color-blue-100);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 0.3rem;
  }
  .continue-bar > span {
    display: block;
    height: 100%;
    background: var(--color-success);
  }
  .continue-pct {
    font-size: 0.8rem;
    color: var(--color-muted);
    font-weight: 600;
  }
  @media (min-width: 680px) {
    .continue-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .step-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .step {
    background: var(--surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.6rem 1.4rem;
  }
  .step > :global(svg) {
    display: none; /* the number is the accent; drop the redundant icon */
  }
  .step h3 {
    font-size: 1.1rem;
    margin: 0;
  }
  .step p {
    color: var(--color-muted);
    margin-top: 0.45rem;
    font-size: 0.95rem;
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--color-blue-600);
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.9rem;
  }
  .value-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .value {
    display: flex;
    gap: 0.9rem;
  }
  .value-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    background: var(--color-blue-50);
    color: var(--color-blue-600);
  }
  .value h3 {
    font-size: 1.1rem;
  }
  .value p {
    color: var(--color-muted);
    margin-top: 0.2rem;
  }

  .community {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
    background: var(--color-blue-50);
    border: 1px solid var(--color-blue-100);
    border-radius: 1rem;
    padding: 1.5rem;
  }
  .community-media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 1rem;
    display: block;
  }
  .community-text h2 {
    margin-bottom: 0.5rem;
  }
  .community-text p {
    color: var(--color-muted);
    margin-bottom: 1rem;
    max-width: 48ch;
  }
  .community-text .btn {
    display: inline-flex;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .testimonial {
    padding: 1.5rem;
    margin: 0;
  }
  .testimonial blockquote {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .testimonial blockquote::before {
    content: '“';
    color: var(--color-blue-400);
    font-size: 1.5rem;
    margin-right: 0.1rem;
  }
  .testimonial figcaption {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
  }
  .testimonial figcaption span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .cta-band {
    background: var(--color-blue-900);
    color: #fff;
    border-radius: 1.25rem;
    margin-top: 3.5rem;
    padding: 2.25rem 0;
  }
  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .cta-band h2 {
    color: #fff;
  }
  .cta-band p {
    color: #cbd5e1;
    margin-top: 0.35rem;
  }

  @media (min-width: 680px) {
    .card-grid,
    .step-grid,
    .testimonial-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .value-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
      padding: 3rem 0 2rem;
    }
    .card-grid,
    .testimonial-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .step-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .community {
      grid-template-columns: 1.1fr 1fr;
      padding: 2.5rem;
    }
  }
</style>

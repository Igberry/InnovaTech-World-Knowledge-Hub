---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getAllCourses } from '../utils/courses';
import { site } from '../config/site';
import { withBase } from '../utils/links';

const courses = await getAllCourses();
const available = courses.filter((c) => c.data.status === 'available');
const soon = courses.filter((c) => c.data.status !== 'available');
const featured = [
  ...available.sort((a, b) => Number(b.data.featured) - Number(a.data.featured)),
  ...soon,
].slice(0, 6);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'InnovaTech World',
  description: site.description,
  url: site.url,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Yenagoa',
    addressRegion: 'Bayelsa State',
    addressCountry: 'NG',
  },
};

const steps = [
  { icon: 'calendar-days', title: 'Weekly lessons', text: 'Follow one clear, written lesson each week at your own pace.' },
  { icon: 'laptop', title: 'Hands-on assignments', text: 'Practise on real datasets and build work you can show.' },
  { icon: 'users', title: 'Mentoring sessions', text: 'Meet your facilitator for live problem-solving and feedback.' },
  { icon: 'folder-git-2', title: 'Portfolio', text: 'Finish with projects and a GitHub profile that prove your skills.' },
];
const values = [
  { icon: 'wrench', title: 'Practical and project-based', text: 'You learn by doing, not by memorising theory.' },
  { icon: 'sprout', title: 'Beginner-friendly', text: 'No experience needed. We start from zero and build up.' },
  { icon: 'globe-2', title: 'Local mentorship, global skills', text: 'In-person support in Yenagoa, skills that travel anywhere.' },
];
---

<BaseLayout jsonLd={[orgJsonLd]}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-text">
      <h1>{site.tagline}</h1>
      <p>
        Practical, beginner-friendly technology training from Yenagoa, Bayelsa — written
        lessons, real datasets, and live mentoring to get you job-ready.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={withBase('/courses/')}>
          Browse Courses
          <Icon name="lucide:arrow-right" width={18} height={18} aria-hidden="true" />
        </a>
        <WhatsAppButton variant="secondary" />
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 200 160" role="img" xmlns="http://www.w3.org/2000/svg">
        <rect x="12" y="24" width="176" height="112" rx="10" fill="var(--color-blue-100)" />
        <rect x="24" y="38" width="152" height="12" rx="4" fill="#fff" />
        <rect x="24" y="60" width="60" height="62" rx="6" fill="var(--color-blue-600)" />
        <rect x="92" y="60" width="84" height="18" rx="4" fill="#fff" />
        <rect x="92" y="84" width="84" height="12" rx="4" fill="var(--color-blue-200)" />
        <rect x="92" y="102" width="56" height="12" rx="4" fill="var(--color-blue-200)" />
        <circle cx="54" cy="150" r="0" fill="none" />
      </svg>
    </div>
  </section>

  <!-- Featured courses -->
  <section class="section">
    <div class="section-head">
      <h2>Courses</h2>
      <a class="section-link" href={withBase('/courses/')}>See all courses →</a>
    </div>
    <div class="card-grid">
      {featured.map((course) => <CourseCard course={course} />)}
    </div>
  </section>

  <!-- How learning works -->
  <section class="section section-alt">
    <h2>How learning works</h2>
    <div class="step-grid">
      {
        steps.map((s, i) => (
          <div class="step">
            <span class="step-num">{i + 1}</span>
            <Icon name={`lucide:${s.icon}`} width={26} height={26} aria-hidden="true" />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Why InnovaTech -->
  <section class="section">
    <h2>Why InnovaTech</h2>
    <div class="value-grid">
      {
        values.map((v) => (
          <div class="value">
            <span class="value-icon" aria-hidden="true">
              <Icon name={`lucide:${v.icon}`} width={24} height={24} />
            </span>
            <div>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA band -->
  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>Ready to start?</h2>
        <p>Talk to us on WhatsApp and we'll help you pick the right course.</p>
      </div>
      <WhatsAppButton variant="secondary" label="Talk to us on WhatsApp" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    background: linear-gradient(180deg, var(--color-blue-50), #fff);
    border-radius: 1.25rem;
    padding: 2.5rem 1.5rem;
    margin-top: 1rem;
  }
  .hero-text h1 {
    font-size: clamp(2.1rem, 1.5rem + 3vw, 3.3rem);
  }
  .hero-text p {
    color: var(--color-muted);
    font-size: 1.15rem;
    margin-top: 1rem;
    max-width: 48ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .hero-art svg {
    width: 100%;
    max-width: 420px;
    height: auto;
    margin-inline: auto;
    display: block;
  }

  .section {
    margin-top: 3.5rem;
  }
  .section h2 {
    font-size: clamp(1.6rem, 1.3rem + 1.4vw, 2.1rem);
    margin-bottom: 1.25rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .section-link {
    font-weight: 600;
    white-space: nowrap;
  }
  .section-alt {
    background: var(--color-blue-50);
    border-radius: 1.25rem;
    padding: 2.5rem 1.5rem;
  }
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .step-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .step {
    position: relative;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 0.9rem;
    padding: 1.25rem;
    color: var(--color-blue-600);
  }
  .step h3 {
    margin-top: 0.6rem;
    font-size: 1.1rem;
  }
  .step p {
    color: var(--color-muted);
    margin-top: 0.3rem;
  }
  .step-num {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-weight: 700;
    color: var(--color-blue-200);
    font-size: 1.5rem;
  }
  .value-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .value {
    display: flex;
    gap: 0.9rem;
  }
  .value-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    background: var(--color-blue-50);
    color: var(--color-blue-600);
  }
  .value h3 {
    font-size: 1.1rem;
  }
  .value p {
    color: var(--color-muted);
    margin-top: 0.2rem;
  }

  .cta-band {
    background: var(--color-blue-900);
    color: #fff;
    border-radius: 1.25rem;
    margin-top: 3.5rem;
    padding: 2.25rem 0;
  }
  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .cta-band h2 {
    color: #fff;
  }
  .cta-band p {
    color: #cbd5e1;
    margin-top: 0.35rem;
  }

  @media (min-width: 680px) {
    .card-grid,
    .step-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .value-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.1fr 0.9fr;
      padding: 3.5rem 3rem;
    }
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .step-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import { getAllCourses } from '../../utils/courses';

const courses = await getAllCourses();
const available = courses.filter((c) => c.data.status === 'available');
const soon = courses.filter((c) => c.data.status !== 'available');
const ordered = [...available, ...soon];

const categories = Array.from(new Set(courses.map((c) => c.data.category))).sort();
const levelRank: Record<string, number> = { Beginner: 1, Intermediate: 2, Advanced: 3 };
---

<BaseLayout
  title="Courses"
  description="Browse InnovaTech World's digital-skills courses — from Data Analysis to Web Development and more."
>
  <header class="page-head">
    <h1>Courses</h1>
    <p>Practical, project-based training. Start with what's available now; more are on the way.</p>
  </header>

  <div class="controls">
    <div class="filters" role="group" aria-label="Filter courses by category">
      <button class="filter-chip is-active" data-filter="all" aria-pressed="true">All</button>
      {
        categories.map((cat) => (
          <button class="filter-chip" data-filter={cat} aria-pressed="false">
            {cat}
          </button>
        ))
      }
    </div>
    <label class="sort">
      <span>Sort</span>
      <select id="course-sort">
        <option value="recommended">Recommended</option>
        <option value="title">Title (A–Z)</option>
        <option value="level">Level</option>
      </select>
    </label>
  </div>

  <div class="card-grid" id="course-grid">
    {
      ordered.map((course, i) => (
        <div
          class="course-cell"
          data-category={course.data.category}
          data-order={i}
          data-title={course.data.title.toLowerCase()}
          data-level={course.data.level ? levelRank[course.data.level] ?? 99 : 99}
        >
          <CourseCard course={course} />
        </div>
      ))
    }
  </div>
  <p class="no-results" hidden>No courses in this category yet.</p>
</BaseLayout>

<style>
  .page-head {
    margin: 0.5rem 0 1.5rem;
  }
  .page-head h1 {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
  }
  .page-head p {
    color: var(--color-muted);
    font-size: 1.1rem;
    margin-top: 0.5rem;
    max-width: 55ch;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sort {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .sort select {
    font: inherit;
    padding: 0.4rem 0.6rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--surface);
    color: var(--color-ink);
  }
  .filter-chip {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--surface);
    color: var(--color-ink);
    cursor: pointer;
  }
  .filter-chip:hover {
    border-color: var(--color-blue-200);
    background: var(--color-blue-50);
  }
  .filter-chip.is-active {
    background: var(--color-blue-600);
    border-color: var(--color-blue-600);
    color: #fff;
  }
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  .no-results {
    color: var(--color-muted);
    margin-top: 1rem;
  }
  @media (min-width: 680px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cells = document.querySelectorAll<HTMLElement>('.course-cell');
  const empty = document.querySelector<HTMLElement>('.no-results');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter!;
      chips.forEach((c) => {
        const active = c === chip;
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-pressed', String(active));
      });
      let shown = 0;
      cells.forEach((cell) => {
        const match = filter === 'all' || cell.dataset.category === filter;
        cell.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    });
  });

  // Sorting
  const grid = document.getElementById('course-grid');
  const sortSel = document.getElementById('course-sort') as HTMLSelectElement | null;
  if (grid && sortSel) {
    const num = (el: HTMLElement, attr: string) => Number(el.dataset[attr] || '0');
    sortSel.addEventListener('change', () => {
      const mode = sortSel.value;
      const items = Array.from(grid.children) as HTMLElement[];
      items.sort((a, b) => {
        if (mode === 'title') return (a.dataset.title || '').localeCompare(b.dataset.title || '');
        if (mode === 'level') return num(a, 'level') - num(b, 'level') || num(a, 'order') - num(b, 'order');
        return num(a, 'order') - num(b, 'order');
      });
      items.forEach((el) => grid.appendChild(el));
    });
  }
</script>

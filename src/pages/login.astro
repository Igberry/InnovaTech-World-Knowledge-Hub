---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const allowSignups = site.portal.allowSignups;
---

<BaseLayout title="Log in" description="Log in to your InnovaTech World student account.">
  <div class="auth-page">
    <div class="card auth-card">
      <h1>Log in</h1>
      <p class="auth-sub">Access your learning, progress and feedback.</p>

      <div id="portal-off" class="auth-note" hidden>
        The student portal isn't set up yet. Please check back later or contact your facilitator.
      </div>

      <form id="login-form" hidden>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required />
        </div>

        <p id="auth-error" class="auth-error" role="alert" hidden></p>
        <p id="auth-ok" class="auth-ok" role="status" hidden></p>

        <button type="submit" class="btn btn-primary" data-submit>Log in</button>

        <div class="auth-alt">
          <button type="button" class="btn btn-ghost" data-magic>Email me a login link</button>
          <button type="button" class="link-btn" data-forgot>Forgot password?</button>
        </div>
      </form>

      {
        allowSignups && (
          <form id="signup-form" hidden>
            <div class="field">
              <label for="su-name">Full name</label>
              <input id="su-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="su-email">Email</label>
              <input id="su-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="su-password">Password</label>
              <input id="su-password" name="password" type="password" autocomplete="new-password" minlength="8" required />
            </div>
            <p id="su-error" class="auth-error" role="alert" hidden />
            <p id="su-ok" class="auth-ok" role="status" hidden />
            <button type="submit" class="btn btn-primary" data-su-submit>Create account</button>
          </form>

          <p class="auth-toggle" hidden>
            <span data-toggle-wrap="to-signup">New here? <button type="button" class="link-btn" data-toggle="signup">Create an account</button></span>
            <span data-toggle-wrap="to-login" hidden><button type="button" class="link-btn" data-toggle="login">← Back to log in</button></span>
          </p>
        )
      }

      <p class="auth-help">
        Accounts are invite-only. If you're a student without access, ask your facilitator to invite you.
        <br />
        <strong>First time from an invite?</strong> Use the email invite link (or "Email me a login link"),
        then set a password under <em>My Learning</em> so you can log in with a password next time.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .auth-page {
    max-width: 28rem;
    margin: 2rem auto;
  }
  .auth-card {
    padding: 2rem;
  }
  .auth-card h1 {
    font-size: 1.8rem;
  }
  .auth-sub {
    color: var(--color-muted);
    margin: 0.3rem 0 1.25rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }
  .field label {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .field input {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--surface);
    color: var(--color-ink);
  }
  .auth-error {
    color: var(--color-danger);
    font-size: 0.9rem;
  }
  .auth-ok {
    color: var(--color-success);
    font-size: 0.9rem;
  }
  .auth-note {
    background: var(--cl-bg-warning);
    border: 1px solid var(--color-warning);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
  }
  #login-form button[data-submit],
  #signup-form button[data-su-submit] {
    width: 100%;
  }
  #signup-form {
    margin-top: 0.5rem;
  }
  .auth-toggle {
    margin-top: 0.9rem;
    font-size: 0.9rem;
  }
  .auth-alt {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .link-btn {
    background: none;
    border: none;
    color: var(--color-blue-700);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    padding: 0.5rem 0;
  }
  .auth-help {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>

<script>
  import { isPortalEnabled } from '../lib/supabase';
  import { currentUser, signInWithPassword, signInWithMagicLink, sendPasswordReset, signUpWithPassword } from '../lib/auth';
  import { withBase } from '../utils/links';

  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const off = document.getElementById('portal-off');
  const errEl = document.getElementById('auth-error')!;
  const okEl = document.getElementById('auth-ok')!;

  function show(el: HTMLElement, msg: string) {
    el.textContent = msg;
    el.hidden = false;
  }
  function clear() {
    errEl.hidden = true;
    okEl.hidden = true;
  }

  if (!isPortalEnabled) {
    if (off) off.hidden = false;
  } else if (form) {
    // Already signed in? Go to the account page.
    currentUser().then((u) => {
      if (u) window.location.href = withBase('/account/');
    });
    form.hidden = false;

    const emailEl = () => (document.getElementById('email') as HTMLInputElement).value.trim();
    const passEl = () => (document.getElementById('password') as HTMLInputElement).value;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clear();
      const r = await signInWithPassword(emailEl(), passEl());
      if (r.ok) window.location.href = withBase('/account/');
      else show(errEl, r.error);
    });

    form.querySelector('[data-magic]')?.addEventListener('click', async () => {
      clear();
      if (!emailEl()) return show(errEl, 'Enter your email first, then tap the link button.');
      const r = await signInWithMagicLink(emailEl());
      if (r.ok) show(okEl, 'Check your email for a login link.');
      else show(errEl, r.error);
    });

    form.querySelector('[data-forgot]')?.addEventListener('click', async () => {
      clear();
      if (!emailEl()) return show(errEl, 'Enter your email first, then tap "Forgot password".');
      const r = await sendPasswordReset(emailEl());
      if (r.ok) show(okEl, 'If that email has an account, a reset link is on its way.');
      else show(errEl, r.error);
    });

    // --- Sign up (only present when allowSignups is on) ---
    const signupForm = document.getElementById('signup-form') as HTMLFormElement | null;
    const toggleWrap = document.querySelector<HTMLElement>('.auth-toggle');
    if (signupForm && toggleWrap) {
      toggleWrap.hidden = false;
      const toSignup = toggleWrap.querySelector<HTMLElement>('[data-toggle-wrap="to-signup"]')!;
      const toLogin = toggleWrap.querySelector<HTMLElement>('[data-toggle-wrap="to-login"]')!;
      const showView = (which: 'login' | 'signup') => {
        form.hidden = which !== 'login';
        signupForm.hidden = which !== 'signup';
        toSignup.hidden = which === 'signup';
        toLogin.hidden = which === 'login';
        clear();
      };
      toggleWrap.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((b) =>
        b.addEventListener('click', () => showView(b.dataset.toggle as 'login' | 'signup')),
      );

      const suErr = document.getElementById('su-error')!;
      const suOk = document.getElementById('su-ok')!;
      signupForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        suErr.hidden = true;
        suOk.hidden = true;
        const name = (document.getElementById('su-name') as HTMLInputElement).value.trim();
        const email = (document.getElementById('su-email') as HTMLInputElement).value.trim();
        const pw = (document.getElementById('su-password') as HTMLInputElement).value;
        if (!name) return show(suErr, 'Please enter your name.');
        const r = await signUpWithPassword(email, pw, name);
        if (r.ok) {
          if (r.data.needsConfirmation) {
            show(suOk, 'Account created. Check your email to confirm, then log in.');
          } else {
            window.location.href = withBase('/account/');
          }
        } else {
          show(suErr, r.error);
        }
      });
    }
  }
</script>

    el.querySelector('[data-att-save]')!.addEventListener('click', async () => {
      const rows = Array.from(el.querySelectorAll<HTMLTableRowElement>('tr[data-uid]')).map((tr) => ({
        user_id: tr.dataset.uid!, course_slug: course, session_date: date,
        status: (tr.querySelector('[data-att-status]') as HTMLSelectElement).value,
      }));
      const msg = el.querySelector('[data-att-msg]')!;
      const res = await saveAttendance(rows);
      msg.textContent = res.ok ? 'Saved.' : res.error;
      msg.className = res.ok ? 'ok' : 'err';
      if (res.ok) attendance = await getAttendance();
    });
  }

  // ---------- Enrolments ----------

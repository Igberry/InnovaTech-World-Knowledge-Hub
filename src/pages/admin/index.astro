  `;
  function ensureCertStyles() {
    if (!document.getElementById('cert-css')) {
      const s = document.createElement('style');
      s.id = 'cert-css';
      s.textContent = CERT_CSS;
      document.head.appendChild(s);
    }
  }
  const niceDate = (iso: string) => {
    const d = iso ? new Date(iso) : new Date();
    return isNaN(d.getTime()) ? iso : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  };
  function certInner(f: Record<string, string>, absolute = false) {
    const origin = absolute ? location.origin : '';
    const logo = origin + withBase('/images/logo.png');
    const verifyUrl = location.origin + withBase('/verify/');
    const meta = [f.duration, f.grade].filter(Boolean).map(esc).join(' · ');
    const course = catalog.find((c) => c.title.toLowerCase() === (f.course || '').toLowerCase());
    const outcomes = course?.outcomes ?? [];
    const skills = outcomes.length
      ? `<div class="cert-skills"><p class="cert-skills-label">Skills demonstrated</p>
         <ul>${outcomes.map((o) => `<li>${esc(o)}</li>`).join('')}</ul></div>`
      : '';
    // Saved signature (public/images/signature.png). Hidden gracefully if not added yet.
    const sigUrl = origin + withBase('/images/signature.png');
    const sigImg = `<img class="cert-sign-img" src="${sigUrl}" alt="" onerror="this.style.display='none'" />`;
    return `<div class="cert-doc"><div class="cert-border">
      <img class="cert-logo" src="${logo}" alt="InnovaTech World" />
      <p class="cert-kicker">InnovaTech World</p>
      <h1 class="cert-h1">Certificate of Completion</h1>
      <p class="cert-sub">This is to certify that</p>
      <p class="cert-name">${esc(f.name) || 'Student Name'}</p>
      <p class="cert-sub">has successfully completed</p>
      <p class="cert-course">${esc(f.course) || 'Course Title'}</p>
      ${meta ? `<p class="cert-meta">${meta}</p>` : '<p class="cert-meta"></p>'}
      ${skills}
      <div class="cert-footer">
        <div><span class="cert-sign-area">${sigImg}</span><span class="cert-signline"></span>David C. Igberi, Lead Facilitator</div>
        <div><span class="cert-sign-area"></span><span class="cert-signline"></span>Date: ${esc(niceDate(f.date))}</div>
      </div>
      <p class="cert-code">Certificate code: <strong>${esc(f.code) || '—'}</strong> · Verify at ${esc(verifyUrl)}</p>
    </div></div>`;
  }

  function bindCertForm() {
    const form = root.querySelector('[data-cert-form]') as HTMLFormElement;
    const codeEl = form.querySelector('[data-cert-code]') as HTMLInputElement;
    const courseEl = form.querySelector('[data-cert-course]') as HTMLInputElement;
    const preview = root.querySelector('[data-cert-preview]') as HTMLElement;
    const msg = form.querySelector('[data-cert-msg]')!;
    const fields = () => ({
      code: codeEl.value,
      name: (form.querySelector('[data-cert-name]') as HTMLInputElement).value,
      email: (form.querySelector('[data-cert-email]') as HTMLInputElement).value,
      course: courseEl.value,
      duration: (form.querySelector('[data-cert-duration]') as HTMLInputElement).value,
      grade: (form.querySelector('[data-cert-grade]') as HTMLInputElement).value,
      date: (form.querySelector('[data-cert-date]') as HTMLInputElement).value,
    });

    ensureCertStyles();
    const refreshPreview = () => { preview.innerHTML = certInner(fields(), false); };
    refreshPreview();
    form.querySelectorAll('input').forEach((i) => i.addEventListener('input', refreshPreview));

    form.querySelector('[data-cert-gen]')!.addEventListener('click', () => {
      codeEl.value = genCode(courseEl.value);
      refreshPreview();
    });

    // Download / Print: open the certificate in its own window and print (Save as PDF).
    form.querySelector('[data-cert-print]')!.addEventListener('click', () => {
      const f = fields();
      const w = window.open('', '_blank');
      if (!w) return;
      w.document.write(
        `<!doctype html><html><head><meta charset="utf-8"><title>Certificate - ${esc(f.name) || 'Student'}</title>` +
        `<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">` +
        `<style>body{margin:0;padding:24px;background:#eef}</style><style>${CERT_CSS}</style></head>` +
        `<body>${certInner(f, true)}<script>window.onload=function(){setTimeout(function(){window.print()},400)}<\/script></body></html>`,
      );
      w.document.close();
    });

    // Email to student: send the certificate via the server function (Gmail SMTP).
    // Requires the certificate to be issued (saved) first, and the sender to be an admin.
    const sendBtn = form.querySelector('[data-cert-send]') as HTMLButtonElement;
    sendBtn.addEventListener('click', async () => {
      const f = fields();
      if (!f.email) { msg.textContent = 'Enter the student email first.'; msg.className = 'err'; return; }
      if (!f.code) { msg.textContent = 'Generate or enter a certificate code first.'; msg.className = 'err'; return; }
      const label = sendBtn.textContent;
      sendBtn.disabled = true; sendBtn.textContent = 'Sending...';
      msg.textContent = 'Sending email with certificate...'; msg.className = '';
      try {
        const sb = getSupabase();
        const token = sb ? (await sb.auth.getSession()).data.session?.access_token : null;
        if (!token) { msg.textContent = 'Please sign in again to send email.'; msg.className = 'err'; return; }
        const course = catalog.find((c) => c.title.toLowerCase() === (f.course || '').toLowerCase());
        const res = await fetch('/api/send-certificate/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            token,
            code: f.code,
            email: f.email,
            verifyUrl: location.origin + withBase('/verify/'),
            signatureUrl: location.origin + withBase('/images/signature.png'),
            achievements: course?.outcomes ?? [],
          }),
        });
        const out = await res.json().catch(() => ({ ok: false, error: 'Unexpected response from the email service.' }));
        if (out.ok) { msg.textContent = 'Email Sent with Certificate to Student (' + f.email + ')'; msg.className = 'ok'; }
        else { msg.textContent = out.error || 'Could not send the email.'; msg.className = 'err'; }
      } catch {
        msg.textContent = 'Could not reach the email service. Try again in a moment.';
        msg.className = 'err';
      } finally { sendBtn.disabled = false; sendBtn.textContent = label; }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      const f = fields();
      const res = await issueCertificate({
        code: f.code, student_name: f.name, course: f.course,
        duration: f.duration, grade: f.grade, issued_at: f.date || undefined,
      });
      btn.disabled = false;
      msg.textContent = res.ok ? 'Issued and saved. Use Download / Print, then Email to student.' : res.error;
      msg.className = res.ok ? 'ok' : 'err';
      if (res.ok) { certificates = await getCertificates(); renderCertificates(); }
    });
  }

  // ---------- CSV exports ----------
  function exportCsv(kind: string) {
    if (kind === 'progress') {
      downloadCsv('progress.csv', ['student', 'email', 'course', 'lesson', 'status', 'updated_at'],
        progress.map((p) => [nameOf(p.user_id), profiles.find((x) => x.id === p.user_id)?.email ?? '', courseTitle(p.course_slug), lessonTitle(p.course_slug, p.lesson_slug), 'completed', p.updated_at]));
    } else if (kind === 'submissions') {
      downloadCsv('submissions.csv', ['student', 'course', 'lesson', 'link', 'note', 'submitted_at', 'review', 'score'],
        submissions.map((s) => {
          const r = reviews.find((x) => x.submission_id === s.id);
          return [nameOf(s.user_id), courseTitle(s.course_slug), lessonTitle(s.course_slug, s.lesson_slug), s.link_url ?? '', s.note ?? '', s.submitted_at, r?.status ?? 'pending', r?.score ?? ''];
        }));
    } else if (kind === 'attendance') {
      downloadCsv('attendance.csv', ['student', 'course', 'date', 'status', 'note'],
        attendance.map((a) => [nameOf(a.user_id), courseTitle(a.course_slug), a.session_date, a.status, a.note ?? '']));
    } else if (kind === 'certificates') {
      downloadCsv('certificates.csv', ['code', 'student', 'course', 'duration', 'result', 'issued'],
        certificates.map((c) => [c.code, c.student_name, c.course, c.duration ?? '', c.grade ?? '', c.issued_at]));
    }
  }

  // ---------- Tabs + boot ----------
  function setupTabs() {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const activate = (tab: HTMLButtonElement, moveFocus = false) => {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.panel !== tab.dataset.tab;
      });
      if (moveFocus) tab.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        const key = (event as KeyboardEvent).key;
        let next = index;
        if (key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (key === 'Home') next = 0;
        else if (key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[next], true);
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-export]').forEach((b) =>
      b.addEventListener('click', () => exportCsv(b.dataset.export!)));
  }

  // ----- Access & Pricing (payments) -----
  const naira = (kobo: number) => '₦' + Math.round((kobo || 0) / 100).toLocaleString('en-NG');
  const userLabel = (uid: string | null) => {
    const p = profiles.find((x) => x.id === uid);
    return p ? (p.full_name || p.email || uid || '-') : (uid || '-');
  };
  const availableCourseOptions = (includeAny: boolean) =>
    (includeAny ? '<option value="">Any course</option>' : '') +
    catalog.filter((c) => c.status === 'available')
      .map((c) => `<option value="${esc(c.slug)}">${esc(c.title)}</option>`).join('');

  let coursePlans: CoursePlanRow[] = [];
  let vouchers: VoucherRow[] = [];
  let payments: PaymentRow[] = [];
  let entitlements: EntitlementRow[] = [];

  function renderPricing() {
    const box = root.querySelector('[data-pricing]') as HTMLElement;
    if (!box) return;
    if (coursePlans.length === 0) { box.innerHTML = '<p class="muted">No plans found. Run migration 0004 to seed pricing.</p>'; return; }
    const ord: Record<string, number> = { basic: 1, advanced: 2, premium: 3 };
    const byCourse: Record<string, CoursePlanRow[]> = {};
    coursePlans.forEach((p) => { (byCourse[p.course_slug] = byCourse[p.course_slug] || []).push(p); });
    box.innerHTML = Object.keys(byCourse).sort().map((slug) => {
      const rows = byCourse[slug].sort((a, b) => (ord[a.plan] || 9) - (ord[b.plan] || 9)).map((p) => `
        <div class="price-row" data-plan-id="${p.id}">
          <strong style="min-width:5rem">${esc(p.plan)}</strong>
          <label>₦ <input type="number" min="0" step="1000" value="${Math.round(p.price_kobo / 100)}" data-price /></label>
          <label>Active <input type="checkbox" ${p.active ? 'checked' : ''} data-active /></label>
          <details><summary>Features</summary><textarea rows="3" data-features>${esc((p.features || []).join('\n'))}</textarea></details>
          <button type="button" class="btn btn-success" data-save-plan>Save</button>
          <span data-plan-msg></span>
        </div>`).join('');
      return `<div class="price-course"><h4>${esc(courseTitle(slug))}</h4>${rows}</div>`;
    }).join('');
    box.querySelectorAll('[data-save-plan]').forEach((btn) => btn.addEventListener('click', async () => {
      const row = (btn as HTMLElement).closest('[data-plan-id]') as HTMLElement;
      const id = row.dataset.planId!;
      const price = Math.round(Number((row.querySelector('[data-price]') as HTMLInputElement).value) || 0);
      const active = (row.querySelector('[data-active]') as HTMLInputElement).checked;
      const features = (row.querySelector('[data-features]') as HTMLTextAreaElement).value.split('\n').map((s) => s.trim()).filter(Boolean);
      const m = row.querySelector('[data-plan-msg]') as HTMLElement;
      m.textContent = 'Saving...'; m.className = '';
      const r = await updateCoursePlan(id, { price_kobo: price * 100, features, active });
      m.textContent = r.ok ? 'Saved.' : r.error; m.className = r.ok ? 'ok' : 'err';
      if (r.ok) coursePlans = await getCoursePlans();
    }));
  }

  function renderVouchers() {
    const box = root.querySelector('[data-vouchers]') as HTMLElement;
    if (!box) return;
    if (vouchers.length === 0) { box.innerHTML = '<p class="muted">No vouchers yet.</p>'; return; }
    box.innerHTML = '<div class="adm-table-wrap" role="region" aria-label="Voucher list" tabindex="0"><table class="adm-table"><thead><tr><th>Code</th><th>Type</th><th>Value</th><th>Scope</th><th>Uses</th><th>Expires</th><th>Actions</th></tr></thead><tbody>' +
      vouchers.map((v) => `<tr>
        <td><code>${esc(v.code)}</code></td><td>${esc(v.kind)}</td>
        <td>${v.kind === 'free' ? '-' : v.kind === 'percent' ? v.value + '%' : naira(v.value)}</td>
        <td>${esc(v.course_slug ? courseTitle(v.course_slug) : 'Any')} / ${esc(v.plan || 'Any')}</td>
        <td>${v.used_count}${v.max_uses != null ? '/' + v.max_uses : ''}</td>
        <td>${v.expires_at ? new Date(v.expires_at).toLocaleDateString() : '-'}</td>
        <td><button class="link-btn" data-vc-toggle="${v.id}" data-active="${v.active}">${v.active ? 'Deactivate' : 'Activate'}</button></td>
      </tr>`).join('') + '</tbody></table></div>';
    box.querySelectorAll('[data-vc-toggle]').forEach((b) => b.addEventListener('click', async () => {
      const id = (b as HTMLElement).getAttribute('data-vc-toggle')!;
      const active = (b as HTMLElement).getAttribute('data-active') !== 'true';

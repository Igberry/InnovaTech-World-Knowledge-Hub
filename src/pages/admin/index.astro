  // ---------- Certificates ----------
  function genCode(course: string) {
    const abbr = (course || 'ITW').split(/\s+/).map((w) => w[0]).join('').toUpperCase().slice(0, 3) || 'ITW';
    const year = new Date().getFullYear();
    const rand = Math.random().toString(36).toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 5);
    return `ITW-${abbr}-${year}-${rand}`;
  }

  function renderCertificates() {
    // Course options for the datalist
    const dl = root.querySelector('#cert-courses')!;
    dl.innerHTML = catalog.map((c) => `<option value="${esc(c.title)}"></option>`).join('');

    const el = root.querySelector('[data-certificates]')!;
    if (certificates.length === 0) {
      el.innerHTML = '<p class="muted">No certificates issued yet.</p>';
    } else {
      const rows = [...certificates]
        .sort((a, b) => b.issued_at.localeCompare(a.issued_at))
        .map(
          (c) => `<tr data-cert="${c.id}">
            <td>${esc(c.code)}</td><td>${esc(c.student_name)}</td><td>${esc(c.course)}</td>
            <td>${esc(c.duration || '-')}</td><td>${esc(c.grade || '-')}</td><td>${esc(c.issued_at)}</td>
            <td><button class="link-btn-danger" data-cert-del="${c.id}">Delete</button></td>
          </tr>`,
        ).join('');
      el.innerHTML = `<div class="wrap"><table class="admin">
        <thead><tr><th>Code</th><th>Student</th><th>Course</th><th>Duration</th><th>Result</th><th>Issued</th><th></th></tr></thead>
        <tbody>${rows}</tbody></table></div>`;
      el.querySelectorAll<HTMLButtonElement>('[data-cert-del]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('Delete this certificate? Its code will no longer verify.')) return;
          const res = await deleteCertificate(b.dataset.certDel!);
          if (res.ok) { certificates = await getCertificates(); renderCertificates(); }
          else alert(res.error);
        }),
      );
    }
  }

  const CERT_CSS = `
    .cert-doc{font-family:'Poppins',system-ui,sans-serif;background:#fff;color:#0f172a;width:100%;}
    .cert-border{border:9px solid #0b3b66;outline:2px solid #0b3b66;outline-offset:6px;padding:40px 48px;text-align:center;background:#fff;}

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogManager from '../../components/BlogManager.astro';
import { buildCatalog } from '../../utils/catalog';

const catalog = await buildCatalog();
---

<BaseLayout title="Facilitator dashboard" description="Admin dashboard for InnovaTech World facilitators.">
  <div id="admin-gate" class="gate">Checking access…</div>

  <div id="admin" hidden>
    <header class="page-head">
      <h1>Facilitator dashboard</h1>
      <p class="muted">Students, submissions, attendance and enrolments.</p>
    </header>

    <div class="tabs" role="tablist" aria-label="Facilitator dashboard sections">
      <button id="tab-students" class="tab is-active" data-tab="students" role="tab" aria-selected="true" aria-controls="panel-students" tabindex="0">Students</button>
      <button id="tab-submissions" class="tab" data-tab="submissions" role="tab" aria-selected="false" aria-controls="panel-submissions" tabindex="-1">Submissions</button>
      <button id="tab-attendance" class="tab" data-tab="attendance" role="tab" aria-selected="false" aria-controls="panel-attendance" tabindex="-1">Attendance</button>
      <button id="tab-enrolments" class="tab" data-tab="enrolments" role="tab" aria-selected="false" aria-controls="panel-enrolments" tabindex="-1">Enrolments</button>
      <button id="tab-certificates" class="tab" data-tab="certificates" role="tab" aria-selected="false" aria-controls="panel-certificates" tabindex="-1">Certificates</button>
      <button id="tab-access" class="tab" data-tab="access" role="tab" aria-selected="false" aria-controls="panel-access" tabindex="-1">Access &amp; Pricing</button>
      <button id="tab-blog" class="tab" data-tab="blog" role="tab" aria-selected="false" aria-controls="panel-blog" tabindex="-1">Blog</button>
    </div>

    <section id="panel-students" data-panel="students" class="panel" role="tabpanel" aria-labelledby="tab-students" tabindex="0">
      <div class="panel-head">
        <h2>Students</h2>
        <button class="btn btn-secondary" data-export="progress">Export progress CSV</button>
      </div>
      <div data-students><p class="muted">Loading…</p></div>
    </section>

    <section id="panel-submissions" data-panel="submissions" class="panel" role="tabpanel" aria-labelledby="tab-submissions" tabindex="0" hidden>
      <div class="panel-head">
        <h2>Submissions</h2>
        <button class="btn btn-secondary" data-export="submissions">Export submissions CSV</button>
      </div>
      <div data-submissions><p class="muted">Loading…</p></div>
    </section>

    <section id="panel-attendance" data-panel="attendance" class="panel" role="tabpanel" aria-labelledby="tab-attendance" tabindex="0" hidden>
      <div class="panel-head"><h2>Attendance</h2>
        <button class="btn btn-secondary" data-export="attendance">Export attendance CSV</button>
      </div>
      <form data-att-controls class="att-controls">
        <label>Course <select data-att-course></select></label>
        <label>Date <input type="date" data-att-date /></label>
        <button type="button" class="btn btn-secondary" data-att-load>Load students</button>
      </form>
      <div data-attendance></div>
    </section>

    <section id="panel-enrolments" data-panel="enrolments" class="panel" role="tabpanel" aria-labelledby="tab-enrolments" tabindex="0" hidden>
      <h2>Enrolments</h2>
      <div data-enrolments><p class="muted">Loading…</p></div>
    </section>

    <section id="panel-access" data-panel="access" class="panel" role="tabpanel" aria-labelledby="tab-access" tabindex="0" hidden>
      <h2>Access &amp; Pricing</h2>
      <p class="muted">Lock courses behind payment, grant free passes, and run discounts. Needs migration 0004.</p>

      <div class="adm-card">
        <h3>Grant a free pass</h3>
        <form data-fp-form class="att-controls">
          <label>Student email <input type="email" data-fp-email placeholder="student@example.com" required /></label>
          <label>Course <select data-fp-course></select></label>
          <label>Plan <select data-fp-plan>
            <option value="basic">Basic</option><option value="advanced">Advanced</option><option value="premium">Premium</option>
          </select></label>
          <button type="submit" class="btn btn-primary">Grant free access</button>
          <span data-fp-msg role="status" aria-live="polite"></span>
        </form>
      </div>

      <div class="adm-card">
        <h3>Create a voucher / discount</h3>
        <form data-vc-form class="att-controls">
          <label>Code <input type="text" data-vc-code placeholder="LAUNCH20" required /></label>
          <label>Type <select data-vc-kind>
            <option value="percent">% off</option>
            <option value="fixed">Naira off</option>
            <option value="free">100% free</option>
          </select></label>
          <label>Value <input type="number" data-vc-value min="0" placeholder="20" /></label>
          <label>Course <select data-vc-course><option value="">Any course</option></select></label>
          <label>Plan <select data-vc-plan>
            <option value="">Any plan</option><option value="basic">Basic</option>
            <option value="advanced">Advanced</option><option value="premium">Premium</option>
          </select></label>
          <label>Max uses <input type="number" data-vc-max min="1" placeholder="unlimited" /></label>
          <label>Expires <input type="date" data-vc-exp /></label>
          <button type="submit" class="btn btn-primary">Create voucher</button>
          <span data-vc-msg role="status" aria-live="polite"></span>
        </form>
        <div data-vouchers><p class="muted">Loading…</p></div>
      </div>

      <div class="adm-card">
        <div class="panel-head"><h3>Pricing (naira)</h3><span data-pricing-msg></span></div>
        <div data-pricing><p class="muted">Loading…</p></div>
      </div>

      <div class="adm-card">
        <h3>Who has access</h3>
        <div data-entitlements><p class="muted">Loading…</p></div>
      </div>

      <div class="adm-card">
        <h3>Payments</h3>
        <div data-payments><p class="muted">No payments yet.</p></div>
      </div>
    </section>

    <section id="panel-certificates" data-panel="certificates" class="panel" role="tabpanel" aria-labelledby="tab-certificates" tabindex="0" hidden>
      <div class="panel-head"><h2>Certificates</h2>
        <button class="btn btn-secondary" data-export="certificates">Export CSV</button>
      </div>
      <form data-cert-form class="adm-card cert-form">
        <h3>Issue a certificate</h3>
        <div class="cert-grid">
          <label>Certificate code
            <span class="cert-code-row">
              <input data-cert-code type="text" placeholder="ITW-WD-2026-ABC123" required />
              <button type="button" class="btn btn-secondary" data-cert-gen>Generate</button>
            </span>
          </label>
          <label>Student name <input data-cert-name type="text" required /></label>
          <label>Student email <input data-cert-email type="email" placeholder="student@example.com" /></label>
          <label>Course <input data-cert-course type="text" list="cert-courses" required /></label>
          <label>Duration <input data-cert-duration type="text" placeholder="12 weeks" /></label>
          <label>Result (optional) <input data-cert-grade type="text" placeholder="Distinction" /></label>
          <label>Issue date <input data-cert-date type="date" /></label>
        </div>
        <datalist id="cert-courses"></datalist>
        <div class="adm-row" style="margin-top:.5rem">
          <button type="submit" class="btn btn-primary">Issue certificate</button>
          <button type="button" class="btn btn-secondary" data-cert-print>Download / Print</button>
          <button type="button" class="btn btn-secondary" data-cert-send>Email to student</button>
          <span data-cert-msg></span>
        </div>
      </form>

      <h3 class="cert-preview-title">Live preview</h3>
      <div class="cert-preview-wrap">
        <div class="cert-preview" data-cert-preview></div>
      </div>

      <div data-certificates><p class="muted">Loading…</p></div>
    </section>

    <BlogManager />
  </div>

  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />
</BaseLayout>

<style>
  .gate { padding: 4rem 1rem; text-align: center; color: var(--color-muted); }
  .page-head { margin: 0.5rem 0 1rem; }
  .page-head h1 { font-size: clamp(1.8rem, 1.4rem + 2vw, 2.4rem); }
  .muted { color: var(--color-muted); }
  .tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1.5rem; }
  .tab {
    font: inherit; font-weight: 600; padding: 0.6rem 1rem; border: none; background: none;
    color: var(--color-muted); cursor: pointer; border-bottom: 2px solid transparent;
  }
  .tab.is-active { color: var(--color-burgundy-text); border-bottom-color: var(--color-burgundy-text); }
  .panel-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .panel-head h2, .panel > h2 { font-size: 1.4rem; }
  table.admin { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  table.admin th, table.admin td { border: 1px solid var(--color-border); padding: 0.5rem 0.65rem; text-align: left; vertical-align: top; }
  table.admin thead th { background: var(--color-blue-50); }
  .wrap { overflow-x: auto; }
  .adm-card { border: 1px solid var(--color-border); border-radius: 0.6rem; padding: 1rem 1.1rem; margin-bottom: 0.75rem; background: var(--surface); }
  .adm-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .att-controls { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .att-controls label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; font-weight: 600; }
  select, input[type='date'], input[type='number'], textarea {
    font: inherit; padding: 0.45rem 0.6rem; border: 1px solid var(--color-border);
    border-radius: 0.45rem; background: var(--surface); color: var(--color-ink);
  }
  .err { color: var(--color-danger); font-size: 0.85rem; }
  .ok { color: var(--color-success); font-size: 0.85rem; }
  .price-course { margin: 0 0 1.25rem; }
  .price-course h4 { margin: 0 0 0.4rem; }
  .price-row {
    display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center;
    margin: 0.4rem 0; padding: 0.5rem 0.6rem; border: 1px solid var(--color-border); border-radius: 0.45rem;
  }
  .price-row label { display: inline-flex; gap: 0.3rem; align-items: center; font-size: 0.85rem; font-weight: 600; }
  .price-row input[type='number'] { width: 7rem; }
  .price-row textarea { min-width: 260px; }
  .adm-table-wrap { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .adm-table-wrap:focus-visible { outline-offset: -2px; }
  .panel, .adm-card, [data-pricing], [data-vouchers], [data-entitlements], [data-payments] { min-width: 0; }
  @media (max-width: 640px) {
    .adm-card { padding: 0.75rem; }
    .att-controls { align-items: stretch; }
    .att-controls label { width: 100%; min-width: 0; }
    .att-controls input, .att-controls select { max-width: 100%; box-sizing: border-box; }
    .price-row { align-items: stretch; flex-direction: column; }
    .price-row label { justify-content: space-between; }
    .price-row input[type='number'] { width: 100%; max-width: 12rem; }
    .price-row textarea { min-width: 0; width: 100%; box-sizing: border-box; }
    .price-row details { width: 100%; }
    .panel-head > button { width: 100%; }
    .adm-table-wrap table { min-width: 38rem; }
  }
  .adm-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-top: 0.5rem; }
  .adm-table th, .adm-table td { text-align: left; padding: 0.35rem 0.5rem; border-bottom: 1px solid var(--color-border); }
  .adm-card + .adm-card { margin-top: 1rem; }
  .mfa-msg { min-height: 1.2em; margin: 0.5rem 0 0; }
  .mfa-msg.ok { color: var(--color-success); }
  .mfa-msg.err { color: var(--color-danger); }
  .cert-form h3 { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .cert-form label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; font-weight: 600; }
  .cert-form input { font-weight: 400; }
  .cert-grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  .cert-code-row { display: flex; gap: 0.5rem; }
  .cert-code-row input { flex: 1; }
  .cert-preview-title { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
  .cert-preview-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: 0.6rem; padding: 1rem; background: #eef2f7; margin-bottom: 1.5rem; }
  .cert-preview { max-width: 820px; min-width: 620px; margin: 0 auto; }
  .link-btn-danger { background: none; border: none; color: var(--color-danger); font: inherit; cursor: pointer; padding: 0; }
  @media (min-width: 640px) { .cert-grid { grid-template-columns: 1fr 1fr; } }
</style>

<style is:global>
  /* The students/submissions/attendance/enrolments/certificates tables and cards
     are injected with JavaScript, so Astro's scoped styles can't reach them.
     These #admin-prefixed global rules style that injected content. */
  #admin table.admin { width: 100%; border-collapse: collapse; font-size: 0.92rem; min-width: 560px; }
  #admin table.admin th,
  #admin table.admin td { border: 1px solid var(--color-border); padding: 0.6rem 0.85rem; text-align: left; vertical-align: top; }
  #admin table.admin thead th { background: var(--color-blue-50); white-space: nowrap; }
  #admin .wrap { overflow-x: auto; }
  #admin .adm-card { border: 1px solid var(--color-border); border-radius: 0.6rem; padding: 1rem 1.1rem; margin-bottom: 0.75rem; background: var(--surface); }
  #admin .adm-card h3 { font-size: 1.05rem; }
  #admin .adm-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  #admin .adm-table-wrap { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  #admin .adm-table-wrap table { min-width: 38rem; }
  #admin .adm-card select,
  #admin .adm-card input,
  #admin .adm-card textarea,
  #admin table.admin select {
    font: inherit; padding: 0.45rem 0.6rem; border: 1px solid var(--color-border);
    border-radius: 0.45rem; background: var(--surface); color: var(--color-ink);
  }
  #admin .err { color: var(--color-danger); font-size: 0.85rem; }
  #admin .ok { color: var(--color-success); font-size: 0.85rem; }
  #admin .pill { font-size: 0.75rem; font-weight: 600; padding: 0.15rem 0.55rem; border-radius: 999px; display: inline-block; }
  #admin .pill.approved { background: #dcfce7; color: #166534; }
  #admin .pill.needs_changes { background: var(--cl-bg-warning); color: #92400e; }
  #admin .pill.pending { background: var(--color-blue-50); color: var(--color-blue-700); }
  #admin .link-btn-danger { background: none; border: none; color: var(--color-danger); font: inherit; cursor: pointer; padding: 0; }
  #admin-gate .mfa-box {
    box-sizing: border-box; width: 100%; max-width: 420px; margin: 2rem auto; padding: 1.5rem; text-align: center;
    border: 1px solid var(--color-border); border-radius: 0.75rem; background: var(--surface);
  }
  #admin-gate .mfa-box h2 { font-size: 1.2rem; margin: 0 0 0.5rem; }
  #admin-gate .mfa-box p { font-size: 0.9rem; color: var(--color-muted); }
  #admin-gate .mfa-qr { width: 200px; height: 200px; margin: 1rem auto; background: #fff; padding: 8px; border-radius: 0.5rem; }
  #admin-gate .mfa-qr svg { width: 100%; height: 100%; display: block; }
  #admin-gate .mfa-secret code { font-size: 0.95rem; word-break: break-all; color: var(--color-ink); }
  #admin-gate .mfa-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem; margin: 0.9rem 0 0.4rem; }
  #admin-gate .mfa-input {
    box-sizing: border-box; display: block; width: 180px; max-width: 100%; height: 2.5rem; margin: 0;
    text-align: center; font-size: 1rem; letter-spacing: 0.2em; padding: 0.4rem 0.5rem;
    border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--surface); color: var(--color-ink);
  }
  #admin-gate .mfa-actions .btn { min-height: 2.25rem; padding: 0.35rem 1rem; line-height: 1.2; }
  #admin-gate .mfa-msg { min-height: 1.2em; margin: 0.5rem 0 0; }
  #admin-gate .mfa-msg.ok { color: var(--color-success); }
  #admin-gate .mfa-msg.err { color: var(--color-danger); }
  #admin .cert-form,
  #admin .cert-form * { box-sizing: border-box; }
  #admin .cert-form,
  #admin .cert-grid,
  #admin .cert-code-row { min-width: 0; max-width: 100%; }
  #admin .cert-form input,
  #admin .cert-form select,
  #admin .cert-form textarea { display: block; width: 100%; min-width: 0; max-width: 100%; }
  #admin .cert-code-row { display: flex; width: 100%; gap: 0.5rem; }
  #admin .cert-code-row input { flex: 1 1 0; }
</style>

<script>
  import { isPortalEnabled, getSupabase } from '../../lib/supabase';
  import {
    currentUser, isAdminMember, getAAL, listVerifiedTotp, enrollTotp, verifyTotp, stepUpTotp,
  } from '../../lib/auth';
  import {
    getProfiles, getEnrollments, getProgress, getSubmissions, getReviews, getAttendance,
    getCertificates, issueCertificate, deleteCertificate,
    saveReview, setEnrollment, saveAttendance, downloadCsv,
    getCoursePlans, updateCoursePlan, getVouchers, createVoucher, setVoucherActive,
    getPayments, getEntitlements, grantFreePass, revokeEntitlement,
    type AdminProfile, type AdminEnrollment, type AdminProgress,
    type AdminSubmission, type AdminReview, type AdminAttendance, type AdminCertificate,
    type CoursePlanRow, type VoucherRow, type PaymentRow, type EntitlementRow,
  } from '../../lib/admin';
  import { withBase } from '../../utils/links';

  type Lesson = { slug: string; title: string };
  type Course = { slug: string; title: string; status: string; outcomes: string[]; lessons: Lesson[] };

  const gate = document.getElementById('admin-gate')!;
  const root = document.getElementById('admin')!;
  const esc = (s: string) =>
    String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

  let catalog: Course[] = [];
  try { catalog = JSON.parse(document.getElementById('catalog')?.textContent || '[]'); } catch {}
  const courseTitle = (slug: string) => catalog.find((c) => c.slug === slug)?.title ?? slug;
  const courseTotal = (slug: string) => catalog.find((c) => c.slug === slug)?.lessons.length ?? 0;
  const lessonTitle = (cs: string, ls: string) =>
    catalog.find((c) => c.slug === cs)?.lessons.find((l) => l.slug === ls)?.title ?? ls;

  // Caches
  let profiles: AdminProfile[] = [];
  let enrollments: AdminEnrollment[] = [];
  let progress: AdminProgress[] = [];
  let submissions: AdminSubmission[] = [];
  let reviews: AdminReview[] = [];
  let attendance: AdminAttendance[] = [];
  let certificates: AdminCertificate[] = [];
  const nameOf = (uid: string) => {
    const p = profiles.find((x) => x.id === uid);
    return p ? (p.full_name || p.email || uid) : uid;
  };

  async function loadAll() {
    [profiles, enrollments, progress, submissions, reviews, attendance, certificates] = await Promise.all([
      getProfiles(), getEnrollments(), getProgress(), getSubmissions(), getReviews(), getAttendance(), getCertificates(),
    ]);
  }

  // ---------- Students ----------
  function renderStudents() {
    const el = root.querySelector('[data-students]')!;
    if (profiles.length === 0) { el.innerHTML = '<p class="muted">No students yet. Invite them in Supabase.</p>'; return; }
    const rows = profiles.map((p) => {
      const myEnr = enrollments.filter((e) => e.user_id === p.id);
      const myProg = progress.filter((pr) => pr.user_id === p.id);
      const lastProg = myProg.map((x) => x.updated_at).sort().at(-1);
      const lastSub = submissions.filter((s) => s.user_id === p.id).map((s) => s.submitted_at).sort().at(-1);
      const last = [lastProg, lastSub].filter(Boolean).sort().at(-1);
      const courses = myEnr.map((e) => {
        const done = myProg.filter((x) => x.course_slug === e.course_slug).length;
        const total = courseTotal(e.course_slug);
        const pct = total ? Math.round((done / total) * 100) : 0;
        return `${esc(courseTitle(e.course_slug))} (${pct}%, ${esc(e.status)})`;
      }).join('<br>') || '<span class="muted">-</span>';
      return `<tr>
        <td>${esc(p.full_name || '-')}</td>
        <td>${esc(p.email || '-')}</td>
        <td>${esc(p.cohort || '-')}</td>
        <td>${courses}</td>
        <td>${last ? new Date(last).toLocaleDateString() : '-'}</td>
      </tr>`;
    }).join('');
    el.innerHTML = `<div class="wrap"><table class="admin">
      <thead><tr><th>Name</th><th>Email</th><th>Cohort</th><th>Courses (progress, status)</th><th>Last activity</th></tr></thead>
      <tbody>${rows}</tbody></table></div>`;
  }

  // ---------- Submissions ----------
  function renderSubmissions() {
    const el = root.querySelector('[data-submissions]')!;
    if (submissions.length === 0) { el.innerHTML = '<p class="muted">No submissions yet.</p>'; return; }
    const byDate = [...submissions].sort((a, b) => b.submitted_at.localeCompare(a.submitted_at));
    el.innerHTML = byDate.map((s) => {
      const r = reviews.find((x) => x.submission_id === s.id);
      const link = s.link_url ? `<a href="${esc(s.link_url)}" target="_blank" rel="noopener noreferrer">open link</a>` : '(no link)';
      return `<div class="adm-card" data-sub="${s.id}">
        <div class="adm-row" style="justify-content:space-between">
          <strong>${esc(nameOf(s.user_id))}</strong>
          <span class="muted">${new Date(s.submitted_at).toLocaleString()}</span>
        </div>
        <p class="muted">${esc(courseTitle(s.course_slug))} · ${esc(lessonTitle(s.course_slug, s.lesson_slug))}</p>
        <p>${link}${s.note ? ' · ' + esc(s.note) : ''}</p>
        <div class="adm-row">
          <label>Status
            <select data-r-status>
              <option value="approved"${r?.status === 'approved' ? ' selected' : ''}>Approved</option>
              <option value="needs_changes"${r?.status === 'needs_changes' ? ' selected' : ''}>Needs changes</option>
            </select>
          </label>
          <label>Score <input type="number" min="0" max="100" step="0.5" data-r-score value="${r?.score ?? ''}" style="width:5rem" /></label>
        </div>
        <textarea data-r-feedback rows="2" placeholder="Feedback" style="width:100%;margin-top:.5rem">${esc(r?.feedback ?? '')}</textarea>
        <div class="adm-row" style="margin-top:.5rem">
          <button class="btn btn-primary" data-r-save>Save review</button>
          <span data-r-msg></span>
        </div>
      </div>`;
    }).join('');

    el.querySelectorAll<HTMLButtonElement>('[data-r-save]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('[data-sub]') as HTMLElement;
        const id = card.dataset.sub!;
        const status = (card.querySelector('[data-r-status]') as HTMLSelectElement).value as 'approved' | 'needs_changes';
        const scoreRaw = (card.querySelector('[data-r-score]') as HTMLInputElement).value;
        const feedback = (card.querySelector('[data-r-feedback]') as HTMLTextAreaElement).value;
        const msg = card.querySelector('[data-r-msg]')!;
        btn.disabled = true;
        const res = await saveReview(id, status, scoreRaw === '' ? null : Number(scoreRaw), feedback);
        btn.disabled = false;
        msg.textContent = res.ok ? 'Saved.' : res.error;
        msg.className = res.ok ? 'ok' : 'err';
        if (res.ok) reviews = await getReviews();
      });
    });
  }

  // ---------- Attendance ----------

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildCatalog } from '../../utils/catalog';

const catalog = await buildCatalog();
---

<BaseLayout title="Facilitator dashboard" description="Admin dashboard for InnovaTech World facilitators.">
  <div id="admin-gate" class="gate">Checking access…</div>

  <div id="admin" hidden>
    <header class="page-head">
      <h1>Facilitator dashboard</h1>
      <p class="muted">Students, submissions, attendance and enrolments.</p>
    </header>

    <div class="tabs" role="tablist">
      <button class="tab is-active" data-tab="students" role="tab">Students</button>
      <button class="tab" data-tab="submissions" role="tab">Submissions</button>
      <button class="tab" data-tab="attendance" role="tab">Attendance</button>
      <button class="tab" data-tab="enrolments" role="tab">Enrolments</button>
      <button class="tab" data-tab="certificates" role="tab">Certificates</button>
    </div>

    <section data-panel="students" class="panel">
      <div class="panel-head">
        <h2>Students</h2>
        <button class="btn btn-secondary" data-export="progress">Export progress CSV</button>
      </div>
      <div data-students><p class="muted">Loading…</p></div>
    </section>

    <section data-panel="submissions" class="panel" hidden>
      <div class="panel-head">
        <h2>Submissions</h2>
        <button class="btn btn-secondary" data-export="submissions">Export submissions CSV</button>
      </div>
      <div data-submissions><p class="muted">Loading…</p></div>
    </section>

    <section data-panel="attendance" class="panel" hidden>
      <div class="panel-head"><h2>Attendance</h2>
        <button class="btn btn-secondary" data-export="attendance">Export attendance CSV</button>
      </div>
      <form data-att-controls class="att-controls">
        <label>Course <select data-att-course></select></label>
        <label>Date <input type="date" data-att-date /></label>
        <button type="button" class="btn btn-secondary" data-att-load>Load students</button>
      </form>
      <div data-attendance></div>
    </section>

    <section data-panel="enrolments" class="panel" hidden>
      <h2>Enrolments</h2>
      <div data-enrolments><p class="muted">Loading…</p></div>
    </section>

    <section data-panel="certificates" class="panel" hidden>
      <div class="panel-head"><h2>Certificates</h2>
        <button class="btn btn-secondary" data-export="certificates">Export CSV</button>
      </div>
      <form data-cert-form class="adm-card cert-form">
        <h3>Issue a certificate</h3>
        <div class="cert-grid">
          <label>Certificate code
            <span class="cert-code-row">
              <input data-cert-code type="text" placeholder="ITW-WD-2026-ABC123" required />
              <button type="button" class="btn btn-secondary" data-cert-gen>Generate</button>
            </span>
          </label>
          <label>Student name <input data-cert-name type="text" required /></label>
          <label>Student email <input data-cert-email type="email" placeholder="student@example.com" /></label>
          <label>Course <input data-cert-course type="text" list="cert-courses" required /></label>
          <label>Duration <input data-cert-duration type="text" placeholder="12 weeks" /></label>
          <label>Result (optional) <input data-cert-grade type="text" placeholder="Distinction" /></label>
          <label>Issue date <input data-cert-date type="date" /></label>
        </div>
        <datalist id="cert-courses"></datalist>
        <div class="adm-row" style="margin-top:.5rem">
          <button type="submit" class="btn btn-primary">Issue certificate</button>
          <button type="button" class="btn btn-secondary" data-cert-print>Download / Print</button>
          <button type="button" class="btn btn-secondary" data-cert-send>Email to student</button>
          <span data-cert-msg></span>
        </div>
      </form>

      <h3 class="cert-preview-title">Live preview</h3>
      <div class="cert-preview-wrap">
        <div class="cert-preview" data-cert-preview></div>
      </div>

      <div data-certificates><p class="muted">Loading…</p></div>
    </section>
  </div>

  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />
</BaseLayout>

<style>
  .gate { padding: 4rem 1rem; text-align: center; color: var(--color-muted); }
  .page-head { margin: 0.5rem 0 1rem; }
  .page-head h1 { font-size: clamp(1.8rem, 1.4rem + 2vw, 2.4rem); }
  .muted { color: var(--color-muted); }
  .tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1.5rem; }
  .tab {
    font: inherit; font-weight: 600; padding: 0.6rem 1rem; border: none; background: none;
    color: var(--color-muted); cursor: pointer; border-bottom: 2px solid transparent;
  }
  .tab.is-active { color: var(--color-blue-700); border-bottom-color: var(--color-blue-600); }
  .panel-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .panel-head h2, .panel > h2 { font-size: 1.4rem; }
  table.admin { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  table.admin th, table.admin td { border: 1px solid var(--color-border); padding: 0.5rem 0.65rem; text-align: left; vertical-align: top; }
  table.admin thead th { background: var(--color-blue-50); }
  .wrap { overflow-x: auto; }
  .adm-card { border: 1px solid var(--color-border); border-radius: 0.6rem; padding: 1rem 1.1rem; margin-bottom: 0.75rem; background: var(--surface); }
  .adm-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .att-controls { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: end; margin-bottom: 1rem; }
  .att-controls label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; font-weight: 600; }
  select, input[type='date'], input[type='number'], textarea {
    font: inherit; padding: 0.45rem 0.6rem; border: 1px solid var(--color-border);
    border-radius: 0.45rem; background: var(--surface); color: var(--color-ink);
  }
  .err { color: var(--color-danger); font-size: 0.85rem; }
  .ok { color: var(--color-success); font-size: 0.85rem; }
  .cert-form h3 { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .cert-form label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; font-weight: 600; }
  .cert-form input { font-weight: 400; }
  .cert-grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  .cert-code-row { display: flex; gap: 0.5rem; }
  .cert-code-row input { flex: 1; }
  .cert-preview-title { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
  .cert-preview-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: 0.6rem; padding: 1rem; background: #eef2f7; margin-bottom: 1.5rem; }
  .cert-preview { max-width: 820px; min-width: 620px; margin: 0 auto; }
  .link-btn-danger { background: none; border: none; color: var(--color-danger); font: inherit; cursor: pointer; padding: 0; }
  @media (min-width: 640px) { .cert-grid { grid-template-columns: 1fr 1fr; } }
</style>

<style is:global>
  /* The students/submissions/attendance/enrolments/certificates tables and cards
     are injected with JavaScript, so Astro's scoped styles can't reach them.
     These #admin-prefixed global rules style that injected content. */
  #admin table.admin { width: 100%; border-collapse: collapse; font-size: 0.92rem; min-width: 560px; }
  #admin table.admin th,
  #admin table.admin td { border: 1px solid var(--color-border); padding: 0.6rem 0.85rem; text-align: left; vertical-align: top; }
  #admin table.admin thead th { background: var(--color-blue-50); white-space: nowrap; }
  #admin .wrap { overflow-x: auto; }
  #admin .adm-card { border: 1px solid var(--color-border); border-radius: 0.6rem; padding: 1rem 1.1rem; margin-bottom: 0.75rem; background: var(--surface); }
  #admin .adm-card h3 { font-size: 1.05rem; }
  #admin .adm-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  #admin .adm-card select,
  #admin .adm-card input,
  #admin .adm-card textarea,
  #admin table.admin select {
    font: inherit; padding: 0.45rem 0.6rem; border: 1px solid var(--color-border);
    border-radius: 0.45rem; background: var(--surface); color: var(--color-ink);
  }
  #admin .err { color: var(--color-danger); font-size: 0.85rem; }
  #admin .ok { color: var(--color-success); font-size: 0.85rem; }
  #admin .pill { font-size: 0.75rem; font-weight: 600; padding: 0.15rem 0.55rem; border-radius: 999px; display: inline-block; }
  #admin .pill.approved { background: #dcfce7; color: #166534; }
  #admin .pill.needs_changes { background: var(--cl-bg-warning); color: #92400e; }
  #admin .pill.pending { background: var(--color-blue-50); color: var(--color-blue-700); }
  #admin .link-btn-danger { background: none; border: none; color: var(--color-danger); font: inherit; cursor: pointer; padding: 0; }
</style>

<script>
  import { isPortalEnabled, getSupabase } from '../../lib/supabase';
  import { currentUser, isAdmin } from '../../lib/auth';
  import {
    getProfiles, getEnrollments, getProgress, getSubmissions, getReviews, getAttendance,
    getCertificates, issueCertificate, deleteCertificate,
    saveReview, setEnrollment, saveAttendance, downloadCsv,
    type AdminProfile, type AdminEnrollment, type AdminProgress,
    type AdminSubmission, type AdminReview, type AdminAttendance, type AdminCertificate,
  } from '../../lib/admin';
  import { withBase } from '../../utils/links';

  type Lesson = { slug: string; title: string };
  type Course = { slug: string; title: string; status: string; lessons: Lesson[] };

  const gate = document.getElementById('admin-gate')!;
  const root = document.getElementById('admin')!;
  const esc = (s: string) =>
    String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

  let catalog: Course[] = [];
  try { catalog = JSON.parse(document.getElementById('catalog')?.textContent || '[]'); } catch {}
  const courseTitle = (slug: string) => catalog.find((c) => c.slug === slug)?.title ?? slug;
  const courseTotal = (slug: string) => catalog.find((c) => c.slug === slug)?.lessons.length ?? 0;
  const lessonTitle = (cs: string, ls: string) =>
    catalog.find((c) => c.slug === cs)?.lessons.find((l) => l.slug === ls)?.title ?? ls;

  // Caches
  let profiles: AdminProfile[] = [];
  let enrollments: AdminEnrollment[] = [];
  let progress: AdminProgress[] = [];
  let submissions: AdminSubmission[] = [];
  let reviews: AdminReview[] = [];
  let attendance: AdminAttendance[] = [];
  let certificates: AdminCertificate[] = [];
  const nameOf = (uid: string) => {
    const p = profiles.find((x) => x.id === uid);
    return p ? (p.full_name || p.email || uid) : uid;
  };

  async function loadAll() {
    [profiles, enrollments, progress, submissions, reviews, attendance, certificates] = await Promise.all([
      getProfiles(), getEnrollments(), getProgress(), getSubmissions(), getReviews(), getAttendance(), getCertificates(),
    ]);
  }

  // ---------- Students ----------
  function renderStudents() {
    const el = root.querySelector('[data-students]')!;
    if (profiles.length === 0) { el.innerHTML = '<p class="muted">No students yet. Invite them in Supabase.</p>'; return; }
    const rows = profiles.map((p) => {
      const myEnr = enrollments.filter((e) => e.user_id === p.id);
      const myProg = progress.filter((pr) => pr.user_id === p.id);
      const lastProg = myProg.map((x) => x.updated_at).sort().at(-1);
      const lastSub = submissions.filter((s) => s.user_id === p.id).map((s) => s.submitted_at).sort().at(-1);
      const last = [lastProg, lastSub].filter(Boolean).sort().at(-1);
      const courses = myEnr.map((e) => {
        const done = myProg.filter((x) => x.course_slug === e.course_slug).length;
        const total = courseTotal(e.course_slug);
        const pct = total ? Math.round((done / total) * 100) : 0;
        return `${esc(courseTitle(e.course_slug))} (${pct}%, ${esc(e.status)})`;
      }).join('<br>') || '<span class="muted">-</span>';
      return `<tr>
        <td>${esc(p.full_name || '-')}</td>
        <td>${esc(p.email || '-')}</td>
        <td>${esc(p.cohort || '-')}</td>
        <td>${courses}</td>
        <td>${last ? new Date(last).toLocaleDateString() : '-'}</td>
      </tr>`;
    }).join('');
    el.innerHTML = `<div class="wrap"><table class="admin">
      <thead><tr><th>Name</th><th>Email</th><th>Cohort</th><th>Courses (progress, status)</th><th>Last activity</th></tr></thead>
      <tbody>${rows}</tbody></table></div>`;
  }

  // ---------- Submissions ----------
  function renderSubmissions() {
    const el = root.querySelector('[data-submissions]')!;
    if (submissions.length === 0) { el.innerHTML = '<p class="muted">No submissions yet.</p>'; return; }
    const byDate = [...submissions].sort((a, b) => b.submitted_at.localeCompare(a.submitted_at));
    el.innerHTML = byDate.map((s) => {
      const r = reviews.find((x) => x.submission_id === s.id);
      const link = s.link_url ? `<a href="${esc(s.link_url)}" target="_blank" rel="noopener noreferrer">open link</a>` : '(no link)';
      return `<div class="adm-card" data-sub="${s.id}">
        <div class="adm-row" style="justify-content:space-between">
          <strong>${esc(nameOf(s.user_id))}</strong>
          <span class="muted">${new Date(s.submitted_at).toLocaleString()}</span>
        </div>
        <p class="muted">${esc(courseTitle(s.course_slug))} · ${esc(lessonTitle(s.course_slug, s.lesson_slug))}</p>
        <p>${link}${s.note ? ' · ' + esc(s.note) : ''}</p>
        <div class="adm-row">
          <label>Status
            <select data-r-status>
              <option value="approved"${r?.status === 'approved' ? ' selected' : ''}>Approved</option>
              <option value="needs_changes"${r?.status === 'needs_changes' ? ' selected' : ''}>Needs changes</option>
            </select>
          </label>
          <label>Score <input type="number" min="0" max="100" step="0.5" data-r-score value="${r?.score ?? ''}" style="width:5rem" /></label>
        </div>
        <textarea data-r-feedback rows="2" placeholder="Feedback" style="width:100%;margin-top:.5rem">${esc(r?.feedback ?? '')}</textarea>
        <div class="adm-row" style="margin-top:.5rem">
          <button class="btn btn-primary" data-r-save>Save review</button>
          <span data-r-msg></span>
        </div>
      </div>`;
    }).join('');

    el.querySelectorAll<HTMLButtonElement>('[data-r-save]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('[data-sub]') as HTMLElement;
        const id = card.dataset.sub!;
        const status = (card.querySelector('[data-r-status]') as HTMLSelectElement).value as 'approved' | 'needs_changes';
        const scoreRaw = (card.querySelector('[data-r-score]') as HTMLInputElement).value;
        const feedback = (card.querySelector('[data-r-feedback]') as HTMLTextAreaElement).value;
        const msg = card.querySelector('[data-r-msg]')!;
        btn.disabled = true;
        const res = await saveReview(id, status, scoreRaw === '' ? null : Number(scoreRaw), feedback);
        btn.disabled = false;
        msg.textContent = res.ok ? 'Saved.' : res.error;
        msg.className = res.ok ? 'ok' : 'err';
        if (res.ok) reviews = await getReviews();
      });
    });
  }

  // ---------- Attendance ----------
  function fillCourseSelect(sel: HTMLSelectElement) {
    sel.innerHTML = catalog.filter((c) => c.status === 'available')
      .map((c) => `<option value="${c.slug}">${esc(c.title)}</option>`).join('');
  }
  function renderAttendanceControls() {
    fillCourseSelect(root.querySelector('[data-att-course]') as HTMLSelectElement);
    const dateEl = root.querySelector('[data-att-date]') as HTMLInputElement;
    if (!dateEl.value) dateEl.value = new Date().toISOString().slice(0, 10);
    root.querySelector('[data-att-load]')!.addEventListener('click', renderAttendanceRoster);
  }
  function renderAttendanceRoster() {
    const course = (root.querySelector('[data-att-course]') as HTMLSelectElement).value;
    const date = (root.querySelector('[data-att-date]') as HTMLInputElement).value;
    const el = root.querySelector('[data-attendance]')!;
    const enrolled = enrollments.filter((e) => e.course_slug === course);
    if (!date) { el.innerHTML = '<p class="err">Pick a date.</p>'; return; }
    if (enrolled.length === 0) { el.innerHTML = '<p class="muted">No students enrolled in this course.</p>'; return; }
    const opts = (uid: string) => {
      const existing = attendance.find((a) => a.user_id === uid && a.course_slug === course && a.session_date === date)?.status;
      return ['present', 'absent', 'excused'].map((s) =>
        `<option value="${s}"${existing === s ? ' selected' : ''}>${s}</option>`).join('');
    };
    el.innerHTML = `<div class="wrap"><table class="admin"><thead><tr><th>Student</th><th>Status</th></tr></thead><tbody>` +
      enrolled.map((e) => `<tr data-uid="${e.user_id}"><td>${esc(nameOf(e.user_id))}</td><td><select data-att-status>${opts(e.user_id)}</select></td></tr>`).join('') +
      `</tbody></table></div>
      <div class="adm-row" style="margin-top:.75rem"><button class="btn btn-primary" data-att-save>Save attendance</button><span data-att-msg></span></div>`;
    el.querySelector('[data-att-save]')!.addEventListener('click', async () => {
      const rows = Array.from(el.querySelectorAll<HTMLTableRowElement>('tr[data-uid]')).map((tr) => ({
        user_id: tr.dataset.uid!, course_slug: course, session_date: date,
        status: (tr.querySelector('[data-att-status]') as HTMLSelectElement).value,
      }));
      const msg = el.querySelector('[data-att-msg]')!;
      const res = await saveAttendance(rows);
      msg.textContent = res.ok ? 'Saved.' : res.error;
      msg.className = res.ok ? 'ok' : 'err';
      if (res.ok) attendance = await getAttendance();
    });
  }

  // ---------- Enrolments ----------
  function renderEnrolments() {
    const el = root.querySelector('[data-enrolments]')!;
    if (profiles.length === 0) { el.innerHTML = '<p class="muted">No students yet.</p>'; return; }
    const courseOpts = catalog.filter((c) => c.status === 'available')
      .map((c) => `<option value="${c.slug}">${esc(c.title)}</option>`).join('');
    el.innerHTML = profiles.map((p) => {
      const myEnr = enrollments.filter((e) => e.user_id === p.id)
        .map((e) => `${esc(courseTitle(e.course_slug))}: ${esc(e.status)}`).join(', ') || '-';
      return `<div class="adm-card" data-uid="${p.id}">
        <strong>${esc(p.full_name || p.email || p.id)}</strong>
        <p class="muted">Current: ${myEnr}</p>
        <div class="adm-row">
          <select data-en-course>${courseOpts}</select>
          <select data-en-status><option value="active">active</option><option value="paused">paused</option><option value="completed">completed</option></select>
          <button class="btn btn-secondary" data-en-save>Save</button>
          <span data-en-msg></span>
        </div>
      </div>`;
    }).join('');
    el.querySelectorAll<HTMLButtonElement>('[data-en-save]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const card = btn.closest('[data-uid]') as HTMLElement;
        const uid = card.dataset.uid!;
        const course = (card.querySelector('[data-en-course]') as HTMLSelectElement).value;
        const status = (card.querySelector('[data-en-status]') as HTMLSelectElement).value as 'active' | 'paused' | 'completed';
        const msg = card.querySelector('[data-en-msg]')!;
        const res = await setEnrollment(uid, course, status);
        msg.textContent = res.ok ? 'Saved.' : res.error;
        msg.className = res.ok ? 'ok' : 'err';
        if (res.ok) { enrollments = await getEnrollments(); }
      });
    });
  }

  // ---------- Certificates ----------
  function genCode(course: string) {
    const abbr = (course || 'ITW').split(/\s+/).map((w) => w[0]).join('').toUpperCase().slice(0, 3) || 'ITW';
    const year = new Date().getFullYear();
    const rand = Math.random().toString(36).toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 5);
    return `ITW-${abbr}-${year}-${rand}`;
  }

  function renderCertificates() {
    // Course options for the datalist
    const dl = root.querySelector('#cert-courses')!;
    dl.innerHTML = catalog.map((c) => `<option value="${esc(c.title)}"></option>`).join('');

    const el = root.querySelector('[data-certificates]')!;
    if (certificates.length === 0) {
      el.innerHTML = '<p class="muted">No certificates issued yet.</p>';
    } else {
      const rows = [...certificates]
        .sort((a, b) => b.issued_at.localeCompare(a.issued_at))
        .map(
          (c) => `<tr data-cert="${c.id}">
            <td>${esc(c.code)}</td><td>${esc(c.student_name)}</td><td>${esc(c.course)}</td>
            <td>${esc(c.duration || '-')}</td><td>${esc(c.grade || '-')}</td><td>${esc(c.issued_at)}</td>
            <td><button class="link-btn-danger" data-cert-del="${c.id}">Delete</button></td>
          </tr>`,
        ).join('');
      el.innerHTML = `<div class="wrap"><table class="admin">
        <thead><tr><th>Code</th><th>Student</th><th>Course</th><th>Duration</th><th>Result</th><th>Issued</th><th></th></tr></thead>
        <tbody>${rows}</tbody></table></div>`;
      el.querySelectorAll<HTMLButtonElement>('[data-cert-del]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('Delete this certificate? Its code will no longer verify.')) return;
          const res = await deleteCertificate(b.dataset.certDel!);
          if (res.ok) { certificates = await getCertificates(); renderCertificates(); }
          else alert(res.error);
        }),
      );
    }
  }

  const CERT_CSS = `
    .cert-doc{font-family:'Poppins',system-ui,sans-serif;background:#fff;color:#0f172a;width:100%;}
    .cert-border{border:9px solid #0b3b66;outline:2px solid #0b3b66;outline-offset:6px;padding:40px 48px;text-align:center;background:#fff;}
    .cert-logo{height:58px;width:auto;margin:0 auto 10px;display:block;}
    .cert-kicker{letter-spacing:.14em;text-transform:uppercase;font-size:12px;color:#0b3b66;font-weight:700;margin:0 0 16px;}
    .cert-h1{font-size:38px;line-height:1.1;margin:0 0 18px;color:#0b3b66;}
    .cert-sub{color:#475569;margin:6px 0;font-size:16px;}
    .cert-name{font-size:32px;font-weight:700;margin:6px 0;color:#0f172a;}
    .cert-course{font-size:23px;font-weight:600;margin:6px 0;color:#0b3b66;}
    .cert-meta{color:#475569;margin:6px 0 18px;}
    .cert-skills{margin:4px auto 20px;max-width:720px;text-align:left;}
    .cert-skills-label{text-align:center;text-transform:uppercase;letter-spacing:.1em;font-size:11px;color:#0b3b66;font-weight:700;margin:0 0 8px;}
    .cert-skills ul{columns:2;column-gap:36px;margin:0;padding-left:18px;font-size:12.5px;color:#334155;}
    .cert-skills li{margin:3px 0;break-inside:avoid;}
    .cert-footer{display:flex;justify-content:space-between;gap:40px;margin-top:30px;}
    .cert-footer>div{flex:1;text-align:center;font-size:13px;color:#0f172a;}
    .cert-sign-area{display:flex;align-items:flex-end;justify-content:center;height:60px;margin:0 16px;}
    .cert-sign-img{max-height:60px;max-width:220px;width:auto;object-fit:contain;}
    .cert-signline{display:block;border-top:1px solid #94a3b8;margin:0 16px 8px;height:1px;}
    .cert-code{margin-top:24px;font-size:12px;color:#475569;}
    @media print{@page{size:A4 landscape;margin:0;}body{margin:0;padding:0;}.cert-doc{width:100%;}}
  `;
  function ensureCertStyles() {
    if (!document.getElementById('cert-css')) {
      const s = document.createElement('style');
      s.id = 'cert-css';
      s.textContent = CERT_CSS;
      document.head.appendChild(s);
    }
  }
  const niceDate = (iso: string) => {
    const d = iso ? new Date(iso) : new Date();
    return isNaN(d.getTime()) ? iso : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  };
  function certInner(f: Record<string, string>, absolute = false) {
    const origin = absolute ? location.origin : '';
    const logo = origin + withBase('/images/logo.png');
    const verifyUrl = location.origin + withBase('/verify/');
    const meta = [f.duration, f.grade].filter(Boolean).map(esc).join(' · ');
    const course = catalog.find((c) => c.title.toLowerCase() === (f.course || '').toLowerCase());
    const outcomes = course?.outcomes ?? [];
    const skills = outcomes.length
      ? `<div class="cert-skills"><p class="cert-skills-label">Skills demonstrated</p>
         <ul>${outcomes.map((o) => `<li>${esc(o)}</li>`).join('')}</ul></div>`
      : '';
    // Saved signature (public/images/signature.png). Hidden gracefully if not added yet.
    const sigUrl = origin + withBase('/images/signature.png');
    const sigImg = `<img class="cert-sign-img" src="${sigUrl}" alt="" onerror="this.style.display='none'" />`;
    return `<div class="cert-doc"><div class="cert-border">
      <img class="cert-logo" src="${logo}" alt="InnovaTech World" />
      <p class="cert-kicker">InnovaTech World</p>
      <h1 class="cert-h1">Certificate of Completion</h1>
      <p class="cert-sub">This is to certify that</p>
      <p class="cert-name">${esc(f.name) || 'Student Name'}</p>
      <p class="cert-sub">has successfully completed</p>
      <p class="cert-course">${esc(f.course) || 'Course Title'}</p>
      ${meta ? `<p class="cert-meta">${meta}</p>` : '<p class="cert-meta"></p>'}
      ${skills}
      <div class="cert-footer">
        <div><span class="cert-sign-area">${sigImg}</span><span class="cert-signline"></span>David C. Igberi, Lead Facilitator</div>
        <div><span class="cert-sign-area"></span><span class="cert-signline"></span>Date: ${esc(niceDate(f.date))}</div>
      </div>
      <p class="cert-code">Certificate code: <strong>${esc(f.code) || '—'}</strong> · Verify at ${esc(verifyUrl)}</p>
    </div></div>`;
  }

  function bindCertForm() {
    const form = root.querySelector('[data-cert-form]') as HTMLFormElement;
    const codeEl = form.querySelector('[data-cert-code]') as HTMLInputElement;
    const courseEl = form.querySelector('[data-cert-course]') as HTMLInputElement;
    const preview = root.querySelector('[data-cert-preview]') as HTMLElement;
    const msg = form.querySelector('[data-cert-msg]')!;
    const fields = () => ({
      code: codeEl.value,
      name: (form.querySelector('[data-cert-name]') as HTMLInputElement).value,
      email: (form.querySelector('[data-cert-email]') as HTMLInputElement).value,
      course: courseEl.value,
      duration: (form.querySelector('[data-cert-duration]') as HTMLInputElement).value,
      grade: (form.querySelector('[data-cert-grade]') as HTMLInputElement).value,
      date: (form.querySelector('[data-cert-date]') as HTMLInputElement).value,
    });

    ensureCertStyles();
    const refreshPreview = () => { preview.innerHTML = certInner(fields(), false); };
    refreshPreview();
    form.querySelectorAll('input').forEach((i) => i.addEventListener('input', refreshPreview));

    form.querySelector('[data-cert-gen]')!.addEventListener('click', () => {
      codeEl.value = genCode(courseEl.value);
      refreshPreview();
    });

    // Download / Print: open the certificate in its own window and print (Save as PDF).
    form.querySelector('[data-cert-print]')!.addEventListener('click', () => {
      const f = fields();
      const w = window.open('', '_blank');
      if (!w) return;
      w.document.write(
        `<!doctype html><html><head><meta charset="utf-8"><title>Certificate - ${esc(f.name) || 'Student'}</title>` +
        `<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap">` +
        `<style>body{margin:0;padding:24px;background:#eef}</style><style>${CERT_CSS}</style></head>` +
        `<body>${certInner(f, true)}<script>window.onload=function(){setTimeout(function(){window.print()},400)}<\/script></body></html>`,
      );
      w.document.close();
    });

    // Email to student: send the certificate via the server function (Gmail SMTP).
    // Requires the certificate to be issued (saved) first, and the sender to be an admin.
    const sendBtn = form.querySelector('[data-cert-send]') as HTMLButtonElement;
    sendBtn.addEventListener('click', async () => {
      const f = fields();
      if (!f.email) { msg.textContent = 'Enter the student email first.'; msg.className = 'err'; return; }
      if (!f.code) { msg.textContent = 'Generate or enter a certificate code first.'; msg.className = 'err'; return; }
      const label = sendBtn.textContent;
      sendBtn.disabled = true; sendBtn.textContent = 'Sending...';
      msg.textContent = 'Sending email with certificate...'; msg.className = '';
      try {
        const sb = getSupabase();
        const token = sb ? (await sb.auth.getSession()).data.session?.access_token : null;
        if (!token) { msg.textContent = 'Please sign in again to send email.'; msg.className = 'err'; return; }
        const course = catalog.find((c) => c.title.toLowerCase() === (f.course || '').toLowerCase());
        const res = await fetch('/api/send-certificate/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            token,
            code: f.code,
            email: f.email,
            verifyUrl: location.origin + withBase('/verify/'),
            signatureUrl: location.origin + withBase('/images/signature.png'),
            achievements: course?.outcomes ?? [],
          }),
        });
        const out = await res.json().catch(() => ({ ok: false, error: 'Unexpected response from the email service.' }));
        if (out.ok) { msg.textContent = 'Email Sent with Certificate to Student (' + f.email + ')'; msg.className = 'ok'; }
        else { msg.textContent = out.error || 'Could not send the email.'; msg.className = 'err'; }
      } catch {
        msg.textContent = 'Could not reach the email service. Try again in a moment.';
        msg.className = 'err';
      } finally { sendBtn.disabled = false; sendBtn.textContent = label; }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      const f = fields();
      const res = await issueCertificate({
        code: f.code, student_name: f.name, course: f.course,
        duration: f.duration, grade: f.grade, issued_at: f.date || undefined,
      });
      btn.disabled = false;
      msg.textContent = res.ok ? 'Issued and saved. Use Download / Print, then Email to student.' : res.error;
      msg.className = res.ok ? 'ok' : 'err';
      if (res.ok) { certificates = await getCertificates(); renderCertificates(); }
    });
  }

  // ---------- CSV exports ----------
  function exportCsv(kind: string) {
    if (kind === 'progress') {
      downloadCsv('progress.csv', ['student', 'email', 'course', 'lesson', 'status', 'updated_at'],
        progress.map((p) => [nameOf(p.user_id), profiles.find((x) => x.id === p.user_id)?.email ?? '', courseTitle(p.course_slug), lessonTitle(p.course_slug, p.lesson_slug), 'completed', p.updated_at]));
    } else if (kind === 'submissions') {
      downloadCsv('submissions.csv', ['student', 'course', 'lesson', 'link', 'note', 'submitted_at', 'review', 'score'],
        submissions.map((s) => {
          const r = reviews.find((x) => x.submission_id === s.id);
          return [nameOf(s.user_id), courseTitle(s.course_slug), lessonTitle(s.course_slug, s.lesson_slug), s.link_url ?? '', s.note ?? '', s.submitted_at, r?.status ?? 'pending', r?.score ?? ''];
        }));
    } else if (kind === 'attendance') {
      downloadCsv('attendance.csv', ['student', 'course', 'date', 'status', 'note'],
        attendance.map((a) => [nameOf(a.user_id), courseTitle(a.course_slug), a.session_date, a.status, a.note ?? '']));
    } else if (kind === 'certificates') {
      downloadCsv('certificates.csv', ['code', 'student', 'course', 'duration', 'result', 'issued'],
        certificates.map((c) => [c.code, c.student_name, c.course, c.duration ?? '', c.grade ?? '', c.issued_at]));
    }
  }

  // ---------- Tabs + boot ----------
  function setupTabs() {
    root.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        root.querySelectorAll('.tab').forEach((t) => t.classList.toggle('is-active', t === tab));
        const name = tab.dataset.tab;
        root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== name));
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-export]').forEach((b) =>
      b.addEventListener('click', () => exportCsv(b.dataset.export!)));
  }

  async function main() {
    if (!isPortalEnabled) { gate.textContent = 'The portal is not configured.'; return; }
    const user = await currentUser();
    if (!user) { window.location.replace(withBase('/login/')); return; }
    if (!(await isAdmin())) {
      gate.innerHTML = 'You do not have admin access. <a href="' + withBase('/account/') + '">Go to My Learning</a>.';
      return;
    }
    await loadAll();
    gate.hidden = true;
    root.hidden = false;
    setupTabs();
    renderStudents();
    renderSubmissions();
    renderAttendanceControls();
    renderEnrolments();
    renderCertificates();
    bindCertForm();
  }

  main().catch((e) => { gate.textContent = 'Error loading the dashboard. Please refresh.'; console.error(e); });
</script>

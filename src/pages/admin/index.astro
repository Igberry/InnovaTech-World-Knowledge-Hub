  function renderEntitlementsList() {
    const box = root.querySelector('[data-entitlements]') as HTMLElement;
    if (!box) return;
    const active = entitlements.filter((e) => e.status === 'active');
    if (active.length === 0) { box.innerHTML = '<p class="muted">No one has access yet.</p>'; return; }
    box.innerHTML = '<div class="adm-table-wrap" role="region" aria-label="Course access list" tabindex="0"><table class="adm-table"><thead><tr><th>Student</th><th>Course</th><th>Plan</th><th>Source</th><th>Actions</th></tr></thead><tbody>' +
      active.map((e) => `<tr><td>${esc(userLabel(e.user_id))}</td><td>${esc(courseTitle(e.course_slug))}</td><td>${esc(e.plan)}</td><td>${esc(e.source)}</td>
        <td><button class="link-btn" data-ent-revoke="${e.id}">Revoke</button></td></tr>`).join('') + '</tbody></table></div>';
    box.querySelectorAll('[data-ent-revoke]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Revoke this access?')) return;
      const r = await revokeEntitlement((b as HTMLElement).getAttribute('data-ent-revoke')!);
      if (r.ok) { entitlements = await getEntitlements(); renderEntitlementsList(); }
    }));
  }

  function renderPayments() {
    const box = root.querySelector('[data-payments]') as HTMLElement;
    if (!box) return;
    if (payments.length === 0) { box.innerHTML = '<p class="muted">No payments yet.</p>'; return; }
    box.innerHTML = '<div class="adm-table-wrap" role="region" aria-label="Payments list" tabindex="0"><table class="adm-table"><thead><tr><th>Date</th><th>Student</th><th>Course</th><th>Plan</th><th>Amount</th><th>Status</th><th>Reference</th></tr></thead><tbody>' +
      payments.map((p) => `<tr><td>${new Date(p.created_at).toLocaleDateString()}</td><td>${esc(userLabel(p.user_id))}</td><td>${esc(courseTitle(p.course_slug))}</td><td>${esc(p.plan)}</td><td>${naira(p.amount_kobo)}</td><td>${esc(p.status)}</td><td><code>${esc(p.reference)}</code></td></tr>`).join('') + '</tbody></table></div>';
  }

  let accessFormsBound = false;
  function bindAccessForms() {
    if (accessFormsBound) return; accessFormsBound = true;
    const fp = root.querySelector('[data-fp-form]') as HTMLFormElement;
    fp?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (root.querySelector('[data-fp-email]') as HTMLInputElement).value.trim();
      const course = (root.querySelector('[data-fp-course]') as HTMLSelectElement).value;
      const plan = (root.querySelector('[data-fp-plan]') as HTMLSelectElement).value;
      const m = root.querySelector('[data-fp-msg]') as HTMLElement;
      m.textContent = 'Granting...'; m.className = '';
      const r = await grantFreePass(email, course, plan);
      m.textContent = r.ok ? 'Free access granted.' : r.error; m.className = r.ok ? 'ok' : 'err';
      if (r.ok) { entitlements = await getEntitlements(); renderEntitlementsList(); fp.reset(); }
    });
    const vc = root.querySelector('[data-vc-form]') as HTMLFormElement;
    vc?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const kind = (root.querySelector('[data-vc-kind]') as HTMLSelectElement).value;
      const rawVal = Number((root.querySelector('[data-vc-value]') as HTMLInputElement).value) || 0;
      const value = kind === 'fixed' ? Math.round(rawVal * 100) : Math.round(rawVal);
      const maxRaw = Number((root.querySelector('[data-vc-max]') as HTMLInputElement).value);
      const expRaw = (root.querySelector('[data-vc-exp]') as HTMLInputElement).value;
      const m = root.querySelector('[data-vc-msg]') as HTMLElement;
      m.textContent = 'Creating...'; m.className = '';
      const r = await createVoucher({
        code: (root.querySelector('[data-vc-code]') as HTMLInputElement).value.trim(),
        kind, value,
        course_slug: (root.querySelector('[data-vc-course]') as HTMLSelectElement).value || null,
        plan: (root.querySelector('[data-vc-plan]') as HTMLSelectElement).value || null,
        max_uses: maxRaw > 0 ? Math.round(maxRaw) : null,
        expires_at: expRaw ? new Date(expRaw + 'T23:59:59').toISOString() : null,
      });
      m.textContent = r.ok ? 'Voucher created.' : r.error; m.className = r.ok ? 'ok' : 'err';
      if (r.ok) { vouchers = await getVouchers(); renderVouchers(); vc.reset(); }
    });
  }

  async function renderAccess() {
    const fpC = root.querySelector('[data-fp-course]') as HTMLSelectElement; if (fpC) fpC.innerHTML = availableCourseOptions(false);
    const vcC = root.querySelector('[data-vc-course]') as HTMLSelectElement; if (vcC) vcC.innerHTML = availableCourseOptions(true);
    [coursePlans, vouchers, payments, entitlements] = await Promise.all([
      getCoursePlans(), getVouchers(), getPayments(), getEntitlements(),
    ]);
    renderPricing(); renderVouchers(); renderEntitlementsList(); renderPayments();
    bindAccessForms();
  }

  // ----- Two-factor (2FA) enforcement for admin -----
  function renderEnroll() {
    gate.innerHTML = '<div class="mfa-box"><p>Starting 2FA setup...</p></div>';
    enrollTotp().then((res) => {
      if (!res.ok) { gate.innerHTML = '<div class="mfa-box"><p class="err">Could not start 2FA setup: ' + esc(res.error) + '</p></div>'; return; }
      const { factorId, qr, secret } = res.data;
      gate.innerHTML =
        '<div class="mfa-box">' +
        '<h2>Set up two-factor authentication</h2>' +
        '<p>Admin access requires 2FA. Scan this QR code in an authenticator app (Google Authenticator, Authy, Microsoft Authenticator), then enter the 6-digit code.</p>' +
        '<div class="mfa-qr">' + qr + '</div>' +
        '<p class="mfa-secret">Can’t scan? Enter this key manually:<br><code>' + esc(secret) + '</code></p>' +
        '<div class="mfa-actions">' +
        '<input id="mfa-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456" class="mfa-input" />' +
        '<button id="mfa-verify" class="btn btn-primary">Verify &amp; enable</button>' +
        '</div>' +
        '<p id="mfa-msg" class="mfa-msg"></p></div>';
      const input = document.getElementById('mfa-code') as HTMLInputElement;
      const msg = document.getElementById('mfa-msg')!;
      const go = async () => {
        msg.textContent = 'Verifying...'; msg.className = 'mfa-msg';
        const v = await verifyTotp(factorId, input.value.trim());
        if (v.ok) { msg.textContent = '2FA enabled.'; msg.className = 'mfa-msg ok'; main(); }
        else { msg.textContent = v.error; msg.className = 'mfa-msg err'; }
      };
      document.getElementById('mfa-verify')!.addEventListener('click', go);
      input.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(); });
      input.focus();
    });
  }

  function renderChallenge() {
    gate.innerHTML =
      '<div class="mfa-box">' +
      '<h2>Two-factor authentication</h2>' +
      '<p>Enter the 6-digit code from your authenticator app to open the admin dashboard.</p>' +
      '<div class="mfa-actions">' +
      '<input id="mfa-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456" class="mfa-input" />' +
      '<button id="mfa-verify" class="btn btn-primary">Verify</button>' +
      '</div>' +
      '<p id="mfa-msg" class="mfa-msg"></p></div>';
    const input = document.getElementById('mfa-code') as HTMLInputElement;
    const msg = document.getElementById('mfa-msg')!;
    const go = async () => {
      msg.textContent = 'Verifying...'; msg.className = 'mfa-msg';
      const v = await stepUpTotp(input.value.trim());
      if (v.ok) { main(); } else { msg.textContent = v.error; msg.className = 'mfa-msg err'; }
    };
    document.getElementById('mfa-verify')!.addEventListener('click', go);
    input.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') go(); });
    input.focus();
  }

  /** Returns true if the session is already aal2; otherwise shows 2FA UI and returns false. */
  async function ensureMfa(): Promise<boolean> {
    const aal = await getAAL();
    if (aal && aal.current === 'aal2') return true;
    const factors = await listVerifiedTotp();
    if (factors.length === 0) { renderEnroll(); return false; }
    renderChallenge();
    return false;
  }

  async function main() {
    if (!isPortalEnabled) { gate.textContent = 'The portal is not configured.'; return; }
    const user = await currentUser();
    if (!user) { window.location.replace(withBase('/login/')); return; }
    if (!(await isAdminMember())) {
      gate.hidden = false; root.hidden = true;
      gate.innerHTML = 'You do not have admin access. <a href="' + withBase('/account/') + '">Go to My Learning</a>.';
      return;
    }
    // Admin requires two-factor auth (step up to aal2 before anything loads).
    gate.hidden = false; root.hidden = true;
    if (!(await ensureMfa())) return;
    await loadAll();
    gate.hidden = true;
    root.hidden = false;
    setupTabs();
    const { initAdminBlog } = await import('../../scripts/admin-blog');
    initAdminBlog();
    renderStudents();
    renderSubmissions();
    renderAttendanceControls();
    renderEnrolments();
    renderCertificates();
    bindCertForm();
    renderAccess();
  }

  main().catch((e) => { gate.textContent = 'Error loading the dashboard. Please refresh.'; console.error(e); });
</script>

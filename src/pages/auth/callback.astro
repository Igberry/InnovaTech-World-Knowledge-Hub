---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Signing you in" description="Completing sign-in.">
  <div class="callback">
    <p id="cb-msg">Signing you in…</p>
  </div>
</BaseLayout>

<style>
  .callback {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-muted);
  }
</style>

<script>
  import { getSupabase, isPortalEnabled } from '../../lib/supabase';
  import { withBase } from '../../utils/links';

  const msg = document.getElementById('cb-msg')!;
  async function finish() {
    if (!isPortalEnabled) {
      msg.textContent = 'The portal is not configured.';
      return;
    }
    const sb = getSupabase()!;
    const params = new URLSearchParams(window.location.search);
    const hash = new URLSearchParams(window.location.hash.replace(/^#/, ''));
    const type = params.get('type') || hash.get('type');
    const tokenHash = params.get('token_hash');
    const isRecovery = type === 'recovery';

    // If anything went wrong on Supabase's side, show it.
    const authErr = params.get('error_description') || hash.get('error_description');
    if (authErr) {
      msg.innerHTML = esc(authErr) + ' <a href="' + withBase('/login/') + '">Try again</a>.';
      return;
    }

    // Newer email links use token_hash + type (invite, recovery, magiclink, signup).
    // Older links use ?code= / #access_token, which detectSessionInUrl handles on load.
    if (tokenHash && type) {
      try {
        await sb.auth.verifyOtp({ token_hash: tokenHash, type: type as any });
      } catch {
        /* fall through to the session poll */
      }
    }

    for (let i = 0; i < 10; i++) {
      const { data } = await sb.auth.getSession();
      if (data.session) {
        window.location.replace(withBase(isRecovery ? '/account/reset-password/' : '/account/'));
        return;
      }
      await new Promise((r) => setTimeout(r, 300));
    }
    msg.innerHTML =
      'We couldn\'t complete sign-in. <a href="' + withBase('/login/') + '">Try logging in again</a>.';
  }
  finish();
</script>

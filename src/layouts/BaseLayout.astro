---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import AuthRedirect from '../components/AuthRedirect.astro';
import PasswordToggle from '../components/PasswordToggle.astro';
import SessionTimeout from '../components/SessionTimeout.astro';
import LuluChat from '../components/LuluChat.astro';
import { site } from '../config/site';
import { withBase } from '../utils/links';

export interface Props {
  title?: string;
  description?: string;
  /** Path to a social share image under public/ (defaults to og-default.png). */
  image?: string;
  /** Extra JSON-LD objects to embed in <head>. */
  jsonLd?: Record<string, unknown>[];
  /** Set true on the lesson page to allow a wider layout. */
  wide?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-default.png',
  jsonLd = [],
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.shortName}` : `${site.name} - ${site.tagline}`;
const siteOrigin = Astro.site?.origin ?? new URL(Astro.url).origin;
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImage = new URL(withBase(image), siteOrigin).toString();
const rootUrl = new URL(withBase('/'), siteOrigin).toString();
const sameAs = Object.values(site.social).filter((url) => url && url !== 'TODO');
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: 'InnovaTech World',
    description: site.description,
    url: rootUrl,
    logo: new URL(withBase('/images/logo.png'), siteOrigin).toString(),
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Yenagoa',
      addressRegion: 'Bayelsa State',
      addressCountry: 'NG',
    },
    founder: { '@type': 'Person', name: site.facilitator.name },
    ...(sameAs.length ? { sameAs } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: rootUrl,
    inLanguage: 'en-NG',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${new URL(withBase('/search/'), siteOrigin).toString()}?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];

function jsonLdString(value: Record<string, unknown>): string {
  return JSON.stringify(value).replace(/</g, '\\u003c');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Set the theme before paint to avoid a flash (follows system unless chosen). -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('itw:theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} - Insights`} href={withBase('/rss.xml')} />

    <meta name="theme-color" content="#0b3b66" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={withBase('/favicon-16.png')} sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      [...siteJsonLd, ...jsonLd].map((obj) => (
        <script type="application/ld+json" set:html={jsonLdString(obj)} />
      ))
    }

    <Analytics />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <AuthRedirect />
    <PasswordToggle />
    <SessionTimeout />
    <Header />
    <main id="main" class={wide ? '' : 'container'} style={wide ? '' : 'padding-block: 2rem 3rem;'}>
      <slot />
    </main>
    <Footer />
    {
      !['/admin/', '/account/', '/login/'].some((path) => Astro.url.pathname.includes(path)) && (
        <LuluChat />
      )
    }
  </body>
</html>

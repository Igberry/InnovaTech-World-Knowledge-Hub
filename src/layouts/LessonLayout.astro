---
import { Icon } from 'astro-icon/components';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CourseSidebar from '../components/CourseSidebar.astro';
import Toc from '../components/Toc.astro';
import DownloadsBox from '../components/DownloadsBox.astro';
import LessonNav from '../components/LessonNav.astro';
import MarkComplete from '../components/MarkComplete.astro';
import AssignmentBox from '../components/AssignmentBox.astro';
import CodeCopy from '../components/CodeCopy.astro';
import type { Course, Lesson } from '../utils/courses';
import { lessonSlug } from '../utils/courses';
import { site } from '../config/site';
import { editOnGitHubUrl, whatsappUrl, emailUrl } from '../utils/links';

export interface Props {
  course: Course;
  lessons: Lesson[];
  lesson: Lesson;
  headings: MarkdownHeading[];
  prev: Lesson | null;
  next: Lesson | null;
  hasAssignment?: boolean;
  jsonLd?: Record<string, unknown>[];
}
const { course, lessons, lesson, headings, prev, next, hasAssignment = false, jsonLd } = Astro.props;
const slug = lessonSlug(lesson);
const d = lesson.data;

const editUrl = editOnGitHubUrl(`src/content/courses/${course.data.slug}/${slug}.md`);
const problemUrl =
  whatsappUrl(`${course.data.title} - ${d.title}`) ??
  emailUrl(`Problem report: ${course.data.title} / ${d.title}`);
---

<BaseLayout title={d.title} description={d.summary} jsonLd={jsonLd} wide>
  <div class="container lesson-wrap">
    <div class="lesson-grid">
      <!-- Left: course contents (collapsible drawer on mobile) -->
      <details class="lesson-drawer" open>
        <summary>
          <Icon name="lucide:list" width={18} height={18} aria-hidden="true" />
          Course contents
        </summary>
        <CourseSidebar
          lessons={lessons}
          courseSlug={course.data.slug}
          courseTitle={course.data.title}
          currentSlug={slug}
        />
      </details>

      <!-- Center: lesson content -->
      <article class="lesson-main">
        <Breadcrumbs
          items={[
            { label: 'Courses', href: '/courses/' },
            { label: course.data.title, href: `/courses/${course.data.slug}/` },
            { label: d.title },
          ]}
        />

        <header class="lesson-head">
          <h1>{d.title}</h1>
          <p class="lesson-summary">{d.summary}</p>
          <div class="lesson-facts">
            {d.week !== undefined && <span class="chip">Week {d.week}</span>}
            {d.estimatedHours && <span class="chip">~{d.estimatedHours} hrs</span>}
            {d.tools?.map((t) => <span class="chip">{t}</span>)}
          </div>
        </header>

        <!-- Mobile: On this page dropdown -->
        <details class="toc-drawer">
          <summary>On this page</summary>
          <Toc headings={headings} />
        </details>

        {d.downloads && <DownloadsBox downloads={d.downloads} />}

        <div class="prose">
          <slot />
        </div>

        {hasAssignment && <AssignmentBox course={course.data.slug} lesson={slug} />}

        <div class="lesson-actions no-print">
          <MarkComplete course={course.data.slug} lesson={slug} />
          <div class="lesson-links">
            {editUrl && (
              <a href={editUrl} target="_blank" rel="noopener noreferrer">
                <Icon name="lucide:pencil" width={15} height={15} aria-hidden="true" /> Edit this page on GitHub
              </a>
            )}
            {problemUrl && (
              <a href={problemUrl} target={problemUrl.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                <Icon name="lucide:flag" width={15} height={15} aria-hidden="true" /> Report a problem
              </a>
            )}
          </div>
        </div>

        <LessonNav prev={prev} next={next} courseSlug={course.data.slug} />
      </article>

      <!-- Right: table of contents (desktop) -->
      <aside class="lesson-toc-col">
        <div class="toc-sticky">
          <Toc headings={headings} />
        </div>
      </aside>
    </div>
  </div>

  <CodeCopy />
</BaseLayout>

<style>
  .lesson-wrap {
    padding-block: 1.5rem 3rem;
  }
  .lesson-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .lesson-main {
    min-width: 0;
  }
  .lesson-head {
    margin: 1rem 0 1.5rem;
  }
  .lesson-head h1 {
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.6rem);
  }
  .lesson-summary {
    color: var(--color-muted);
    font-size: 1.1rem;
    margin-top: 0.5rem;
    max-width: 62ch;
  }
  .lesson-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .lesson-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  .lesson-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.875rem;
  }
  .lesson-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted);
    text-decoration: none;
  }
  .lesson-links a:hover {
    color: var(--color-blue-700);
    text-decoration: underline;
  }

  /* Drawers: summaries only show on mobile */
  .lesson-drawer,
  .toc-drawer {
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    padding: 0.5rem 0.9rem;
  }
  .lesson-drawer > summary,
  .toc-drawer > summary {
    cursor: pointer;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0;
    list-style: none;
  }
  .lesson-drawer[open] > :global(.lesson-sidebar) {
    margin-top: 0.75rem;
  }
  .toc-drawer {
    margin-bottom: 1.5rem;
  }
  .lesson-toc-col {
    display: none;
  }

  @media (min-width: 1024px) {
    .lesson-grid {
      grid-template-columns: 16rem minmax(0, 1fr) 15rem;
      gap: 2.5rem;
      align-items: start;
    }
    .lesson-drawer {
      border: none;
      padding: 0;
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
    .lesson-drawer > summary,
    .toc-drawer {
      display: none;
    }
    /* On desktop the drawer is always expanded, even if closed on mobile first. */
    .lesson-drawer:not([open]) > :not(summary) {
      display: block;
    }
    .lesson-toc-col {
      display: block;
    }
    .toc-sticky {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }
</style>

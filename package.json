{
  "name": "innovatech-knowledge-hub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "InnovaTech World Knowledge Hub — a fast, mobile-first learning site for InnovaTech World's training courses.",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "check:supabase": "node scripts/check-supabase-target.mjs",
    "dev": "npm run check:supabase && astro dev",
    "start": "npm run dev",
    "build": "npm run check:supabase && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check:astro": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "test:facilitator": "node scripts/test-facilitator-stripped.mjs",
    "verify": "npm run build && npm run check:links && npm run test:facilitator",
    "import:data-analysis": "node scripts/import-data-analysis-course.mjs",
    "generate:assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource/poppins": "^5.1.1",
    "@iconify-json/lucide": "^1.2.18",
    "astro": "^5.1.1",
    "astro-icon": "^1.1.5",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "pagefind": "^1.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
